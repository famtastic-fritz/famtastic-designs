{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://famtasticdesigns.com/schemas/site-studio-build-packet.v1.schema.json",
  "title": "FAMtastic Site Studio build packet",
  "type": "object",
  "required": ["schema", "packet_id", "idempotency_key", "request_id", "project_id", "build_class", "selected_direction_ids", "brief", "artifacts", "stage_ledger", "return_contract"],
  "properties": {
    "schema": {"const": "famtastic.site-studio.build-packet.v1"},
    "packet_id": {"type": "string", "minLength": 8},
    "idempotency_key": {"type": "string", "minLength": 8},
    "request_id": {"type": "string", "minLength": 1},
    "project_id": {"type": "string", "minLength": 1},
    "build_class": {"enum": ["free", "low", "medium", "premium", "premium_brain_free_workers", "custom"]},
    "selected_direction_ids": {"type": "array", "minItems": 1, "maxItems": 2, "uniqueItems": true, "items": {"pattern": "^direction-[a-f]$"}},
    "brief": {"type": "object"},
    "artifacts": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["role", "path", "sha256", "bytes"]}},
    "stage_ledger": {"type": "array", "minItems": 1},
    "build_dna": {
      "type": "object",
      "description": "Additive pointer to the immutable FAMtastic Build DNA record copied into packet-files/build-dna.json for all new packets.",
      "required": ["schema", "build_id", "path", "sha256", "status"],
      "properties": {
        "schema": {"const": "famtastic.build-dna.v1"},
        "build_id": {"type": "string", "minLength": 8},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "status": {"enum": ["complete", "legacy_missing", "gated"]}
      },
      "additionalProperties": true
    },
    "research_enrichment": {
      "type": "object",
      "description": "Optional, provenance-only research context. It is absent unless explicitly requested with an upstream research execution receipt and never makes research a required Site Studio build stage.",
      "required": ["requested", "actual", "receipt"],
      "additionalProperties": false,
      "properties": {
        "requested": {
          "type": "object",
          "required": ["status", "adapter"],
          "additionalProperties": false,
          "properties": {
            "status": {"const": "optional"},
            "adapter": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,160}$"},
            "model": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,160}$"},
            "thinking": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,160}$"},
            "permission_mode": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,160}$"}
          }
        },
        "actual": {
          "type": "object",
          "required": ["status", "provider", "adapter"],
          "additionalProperties": false,
          "properties": {
            "status": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,160}$"},
            "provider": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,160}$"},
            "adapter": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,160}$"},
            "agent": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,160}$"},
            "model": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,160}$"},
            "execution_class": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,160}$"},
            "research_status": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,160}$"}
          }
        },
        "receipt": {
          "type": "object",
          "required": ["schema", "path", "sha256"],
          "additionalProperties": false,
          "properties": {
            "schema": {"const": "famtastic.research-execution.v1"},
            "path": {"type": "string", "pattern": "^packet-files/research-execution\\.json$"},
            "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
          }
        }
      }
    },
    "return_contract": {"type": "object", "required": ["schema", "signature_algorithm"]}
  },
  "additionalProperties": true
}

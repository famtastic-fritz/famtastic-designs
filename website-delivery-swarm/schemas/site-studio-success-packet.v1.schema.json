{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://famtasticdesigns.com/schemas/site-studio-success-packet.v1.schema.json",
  "title": "Site Studio success packet",
  "type": "object",
  "required": ["schema", "event_id", "packet_id", "idempotency_key", "request_id", "project_id", "build_id", "status", "artifacts", "stage_ledger", "completed_at"],
  "properties": {
    "schema": {"const": "site-studio.build-success.v1"},
    "event_id": {"type": "string", "minLength": 8},
    "packet_id": {"type": "string", "minLength": 8},
    "idempotency_key": {"type": "string", "minLength": 8},
    "request_id": {"type": "string", "minLength": 1},
    "project_id": {"type": "string", "minLength": 1},
    "build_id": {"type": "string", "minLength": 1},
    "status": {"const": "succeeded"},
    "artifacts": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["role", "uri", "sha256"]}},
    "stage_ledger": {"type": "array", "minItems": 1},
    "completed_at": {"type": "string"}
  },
  "additionalProperties": true
}

# FAMtastic Designs SPA serving rules (shipped by deploy-frontend-godaddy.sh).
# 1) The app shell must never be cached: stale shells reference dead hashed
#    assets and render as unstyled soup.
# 2) Missing hashed assets must 404 loudly instead of falling back to HTML.

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "now"
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "index\.html$|\.frontend-release$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{REQUEST_URI} ^/assets/ [NC]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^ - [R=404,L]
  # Platform domain-verification files: tolerate trailing slash (TikTok fetches /file.txt/).
  # Match requires the slash so the rewritten slashless URL exits the loop.
  RewriteRule ^(tiktok[A-Za-z0-9]+\.txt)/$ /$1 [L]

  # The original Thirst Trap gift concept is archived under /v1/. The stable
  # showcase entry now opens the production storefront without duplicating
  # editable content or runtime state across two public pages.
  RewriteRule ^showcase/thirst-trap-772/?$ /showcase/thirst-trap-772/v2/ [R=302,L]

  # Signed proof rooms are dynamic React routes. Keep this deliberately narrow:
  # the same document root also serves Drupal and static campaign experiences.
  # React will validate the token; Apache must not 404 before it can load.
  RewriteRule ^proofs/share/[0-9a-f-]{36}/[0-9a-f]{64}/?$ /index.html [L]
  RewriteRule ^proofs/preview/[0-9a-f-]{36}/[0-9a-f]{64}/?$ /index.html [L]

  # Token-scoped prospect pipeline routes (ProofHub, payment return, intake, status).
  RewriteRule ^p/[^/]+/?$ /index.html [L]

  # Owner-invited private planning interviews. The bearer secret is kept in the
  # browser-only URL fragment; this rule only admits the opaque public id to
  # the React shell and does not broaden the shared Drupal document root.
  RewriteRule ^deep-dive/[^/]+/?$ /index.html [L]

  # Customer account links, checkout purchase, and direct intake routes.
  RewriteRule ^(?:login|verify-email|reset-password|buy|purchase|pricing|intake)(?:/.*)?$ /index.html [L]

  # Public film library. The build writes a real index.html for /watch and for
  # every /watch/<slug>, so those requests resolve as files and never reach a
  # rewrite. These rules exist for the cases that DO reach it: a trailing-slash
  # variant, a stale or mistyped slug, and any film added to the catalog before
  # its shell is rebuilt. Without them the request falls through this
  # allowlist-only rule set and 404s in production even though the React route
  # is correct.
  #
  # Both conditions are load-bearing. `!-f` keeps these lines off the MP4s and
  # posters, which are real files that must be served as themselves. `!-d` keeps
  # them off the generated per-film shells: /watch/ and /watch/<slug>/ are real
  # DIRECTORIES holding their own index.html, and mod_rewrite runs before
  # DirectoryIndex — without `!-d` these rules would quietly replace every
  # film's structured-data shell with the generic app shell, which is the exact
  # failure this route was built to avoid.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^watch/?$ /index.html [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^watch/[^/]+/?$ /index.html [L]

  # Short legal-URL aliases (client-side Navigate to the canonical shell below).
  # TikTok's app review specifically checks these short paths.
  RewriteRule ^terms/?$ /index.html [L]
  RewriteRule ^privacy/?$ /index.html [L]

  # /onboarding never existed as a real route on this site — every campaign's
  # tracked link (scripts/queue-campaign-drops.py DEFAULT_LANDING) has been
  # pointing here since before this repo's records begin, meaning every
  # published post's CTA has 404'd. The real destination per this project's
  # own CTA doctrine is /buy?sku=... — redirect instead of silently 404ing so
  # already-published links start working without editing any live post text.
  RewriteRule ^onboarding/?$ /buy [R=301,L,QSA]
</IfModule>

# The Drupal backend root (/web/) is not a landing surface - route it to the SPA.
RewriteRule ^web/?$ https://famtasticdesigns.com/ [R=302,L]

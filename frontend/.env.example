# Base URL of the headless Drupal 11 backend (no trailing slash).
# Leave EMPTY for local dev so the Vite proxy handles /jsonapi, /api and /oauth
# (same-origin, no CORS). Set to an absolute URL only for a decoupled prod SPA.
VITE_DRUPAL_BASE_URL=

# Where the Vite dev proxy forwards backend paths (only used in `vite dev`).
# Point this at wherever Drupal is served locally.
VITE_DRUPAL_PROXY_TARGET=http://localhost:8080

# OAuth client_id (Drupal Consumer) used by the SPA admin login
# (simple_oauth password / refresh_token grants — see src/api/drupal.js).
VITE_OAUTH_CLIENT_ID=famtastic_spa

# Google Analytics 4 measurement ID (for example, G-XXXXXXXXXX).
# Leave empty to disable Google Analytics locally.
VITE_GA_MEASUREMENT_ID=

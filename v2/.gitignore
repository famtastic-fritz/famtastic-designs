# ── OS noise ──────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride
._*
Thumbs.db
Desktop.ini

# ── Editor / IDE noise ────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
*~

# ── Backend (Drupal) — backend/.gitignore is authoritative;
#     keep these so a bare `git add .` at v2 root stays safe ──
backend/vendor/
backend/web/core/
backend/web/modules/contrib/
backend/web/themes/contrib/
backend/web/sites/default/files/*
!backend/web/sites/default/files/.gitkeep
backend/web/sites/default/settings.local.php

# ── Frontend (React/Vite) ─────────────────────────────────
frontend/node_modules/
frontend/dist/
frontend/.env
frontend/.env.local

# ---------------------------------------------------------------------------
# FAMtastic Designs v2 backend — Drupal 11 composer project .gitignore
# ---------------------------------------------------------------------------

# Composer-managed code (installed by `composer install`).
/vendor/
/web/core/
/web/modules/contrib/
/web/themes/contrib/
/web/profiles/contrib/
/web/libraries/
/drush/Commands/contrib/

# Drupal core scaffold output in the docroot (regenerated by composer).
# Custom code under web/modules/custom and web/themes/custom (including the
# famtastic_admin theme) and web/sites/default/settings.php IS tracked.
/web/.csslintrc
/web/.editorconfig
/web/.eslintignore
/web/.eslintrc.json
/web/.gitattributes
/web/.ht.router.php
/web/.htaccess
/web/autoload.php
/web/example.gitignore
/web/index.php
/web/INSTALL.txt
/web/README.md
/web/robots.txt
/web/update.php
/web/web.config
/web/sites/README.txt
/web/sites/development.services.yml
/web/sites/example.settings.local.php
/web/sites/example.sites.php
/web/modules/README.txt
/web/profiles/README.txt
/web/themes/README.txt

# Uploaded/generated files (public + private).
/web/sites/*/files/*
!/web/sites/default/files/.gitkeep
/private/*
!/private/.gitkeep

# Environment-specific settings and secrets (settings.php itself is tracked;
# it contains only safe local-dev placeholders).
/web/sites/*/settings.local.php
.env
.env.*

# OS / editor noise.
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# NOTE: config/sync is intentionally NOT ignored — it is the canonical
# configuration source of truth (see config/README.md). composer.lock is
# committed on purpose to keep installs reproducible.
/.editorconfig
/.gitattributes
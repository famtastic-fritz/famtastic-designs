<?php

/**
 * @file
 * Adds a "View on Frontend" local task tab to node pages.
 *
 * In this headless setup, Drupal's own "View" tab renders the raw node with
 * the backend theme — useful for structure, not for design proofing. The
 * real presentation lives in the React SPA, so every node gets a tab that
 * opens its frontend URL (path alias on the SPA origin) in a new browser tab.
 */

use Drupal\Core\Url;
use Drupal\node\NodeInterface;

/**
 * Frontend base URL per environment. Override in settings.local.php:
 *   $config['famtastic_preview.settings']['frontend_base'] = 'https://famtasticdesigns.com';
 */
const FAMTASTIC_PREVIEW_DEFAULT_FRONTEND = 'http://localhost:5173';

/**
 * Implements hook_menu_local_tasks_alter().
 */
function famtastic_preview_menu_local_tasks_alter(&$data) {
  if (empty($data['tabs'][0]['entity.node.canonical'])) {
    return;
  }

  $node = \Drupal::routeMatch()->getParameter('node');
  if (!$node instanceof NodeInterface) {
    return;
  }

  $alias = \Drupal::service('path_alias.manager')->getAliasByPath('/node/' . $node->id());
  // The SPA owns marketing routes; Drupal node paths only exist for previews.
  // Splash pages (e.g. /tv) and aliased marketing nodes resolve to their
  // public alias; everything else falls back to the alias as-is.
  $frontend_base = \Drupal::config('famtastic_preview.settings')->get('frontend_base')
    ?: FAMTASTIC_PREVIEW_DEFAULT_FRONTEND;

  $data['tabs'][0]['famtastic_preview.frontend'] = [
    '#theme' => 'menu_local_task',
    '#link' => [
      'title' => t('View on Frontend'),
      'url' => Url::fromUri($frontend_base . $alias, [
        'attributes' => [
          'target' => '_blank',
          'rel' => 'noopener noreferrer',
        ],
      ]),
    ],
    '#weight' => 10,
  ];
}

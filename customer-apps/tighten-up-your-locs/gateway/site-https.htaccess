# LOCS_CANONICAL_HTTPS_V1 — exact business domain; keep private route gateways intact.
RewriteEngine On
RewriteCond %{HTTP_HOST} ^(?:www\.)?tightenupyourlocs\.com(?::[0-9]+)?$ [NC]
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} ^www\.tightenupyourlocs\.com(?::[0-9]+)?$ [NC]
RewriteRule ^ https://tightenupyourlocs.com%{REQUEST_URI} [R=308,L,NE]

<IfModule mod_headers.c>
Header always set Strict-Transport-Security "max-age=31536000"
</IfModule>

{
    "name": "famtastic/site-famtastic-designs-backend",
    "description": "FAMtastic Designs v2 — headless Drupal 11 CMS backend (JSON:API) for the React 18 SPA frontend.",
    "type": "project",
    "license": "proprietary",
    "repositories": [
        {
            "type": "composer",
            "url": "https://packages.drupal.org/8"
        }
    ],
    "require": {
        "php": ">=8.3",
        "composer/installers": "^2.0",
        "drupal/admin_toolbar": "^3.6",
        "drupal/commerce": "^3.3",
        "drupal/commerce_stripe": "^2.2",
        "drupal/consumers": "^1.24",
        "drupal/core-composer-scaffold": "^11",
        "drupal/core-project-message": "^11",
        "drupal/core-recommended": "^11",
        "drupal/ctools": "^4.1",
        "drupal/jsonapi_extras": "^3.28",
        "drupal/jsonapi_menu_items": "^1.2",
        "drupal/jsonapi_views": "^1.1",
        "drupal/paragraphs": "^1.21",
        "drupal/pathauto": "^1.15",
        "drupal/simple_oauth": "^6.0",
        "drupal/smtp": "^1.4",
        "drupal/token": "^1.17",
        "drupal/webform": "^6.3",
        "drush/drush": "^13"
    },
    "conflict": {
        "drupal/drupal": "*"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "drupal/core-composer-scaffold": true,
            "drupal/core-project-message": true,
            "phpstan/extension-installer": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "symfony/runtime": true
        },
        "sort-packages": true
    },
    "extra": {
        "drupal-scaffold": {
            "locations": {
                "web-root": "web/"
            }
        },
        "installer-paths": {
            "web/core": [
                "type:drupal-core"
            ],
            "web/libraries/{$name}": [
                "type:drupal-library"
            ],
            "web/modules/contrib/{$name}": [
                "type:drupal-module"
            ],
            "web/profiles/contrib/{$name}": [
                "type:drupal-profile"
            ],
            "web/themes/contrib/{$name}": [
                "type:drupal-theme"
            ],
            "drush/Commands/contrib/{$name}": [
                "type:drupal-drush"
            ],
            "web/modules/custom/{$name}": [
                "type:drupal-module-custom"
            ],
            "web/themes/custom/{$name}": [
                "type:drupal-theme-custom"
            ]
        },
        "drupal-core-project-message": {
            "include-keys": [
                "homepage",
                "support"
            ],
            "post-create-project-cmd-message": [
                "<bg=green;fg=black> FAMtastic Designs v2 backend (headless Drupal 11) </>",
                "  * Docroot is web/ — serve it at http://localhost:8080",
                "  * Run ./setup.sh to install the site and enable the API stack",
                "  * Configuration syncs to config/sync (see config/README.md)"
            ]
        }
    },
    "require-dev": {
        "drupal/core-dev": "^11"
    }
}

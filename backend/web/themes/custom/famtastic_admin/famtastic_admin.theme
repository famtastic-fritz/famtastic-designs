<?php

/**
 * @file
 * FAMtastic Admin theme hooks.
 *
 * Dark + lime brand layer on top of Claro. Intentionally minimal: all of the
 * visual work lives in css/famtastic-admin.css, delivered via the
 * "global-styling" library.
 */

declare(strict_types=1);

/**
 * Implements hook_preprocess_page().
 *
 * Attaches the brand stylesheet to every page rendered by this theme. The
 * library is already auto-attached via the "libraries" key in
 * famtastic_admin.info.yml; attaching it here as well is harmless (Drupal
 * de-duplicates identical library attachments) and guarantees the CSS is
 * present on admin pages rendered outside the standard page template.
 */
function famtastic_admin_preprocess_page(array &$variables): void {
  $variables['#attached']['library'][] = 'famtastic_admin/global-styling';

  $route_name = \Drupal::routeMatch()->getRouteName();
  if (in_array($route_name, ['user.login', 'user.pass', 'user.reset', 'user.reset.login'], TRUE)) {
    $variables['famtastic_auth_home_url'] = \Drupal\Core\Url::fromRoute('<front>')->toString();
    $variables['famtastic_auth_logo_url'] = $variables['base_path'] . $variables['directory'] . '/logo.svg';
  }

  $route = \Drupal::routeMatch()->getRouteObject();
  if (!$route || !$route->getOption('_admin_route')) {
    return;
  }

  // Keep the navigation native: these are existing, permission-protected
  // Drupal routes, not JavaScript destinations or implied operational actions.
  if (!str_starts_with($route_name, 'famtastic_pipeline.')) {
    return;
  }
  $links = [
    'operations' => ['Operations', 'famtastic_pipeline.operations'],
    'attention' => ['Attention', 'famtastic_pipeline.operations_attention'],
    'campaigns' => ['Campaigns', 'famtastic_pipeline.campaign_operations'],
    'marketing' => ['Marketing', 'famtastic_pipeline.marketing'],
    'analytics' => ['Analytics', 'famtastic_pipeline.analytics'],
    'settings' => ['Settings', 'famtastic_pipeline.settings'],
  ];
  $items = [];
  foreach ($links as $key => [$label, $destination]) {
    $items[$key] = [
      '#type' => 'link',
      '#title' => $label,
      '#url' => \Drupal\Core\Url::fromRoute($destination),
      '#attributes' => [
        'class' => ['famtastic-admin-nav__link'],
        'aria-current' => $route_name === $destination ? 'page' : NULL,
      ],
    ];
  }
  $variables['famtastic_admin_navigation'] = [
    '#type' => 'container',
    '#attributes' => ['class' => ['famtastic-admin-nav'], 'aria-label' => 'FAMtastic staff navigation'],
  ] + $items;
}

/**
 * Implements hook_preprocess_html().
 *
 * Applies an explicit shell class to all standard Drupal administration
 * routes. This is deliberately route-metadata based, so future native admin
 * forms, lists, and configuration pages inherit the system without a route
 * allowlist.
 */
function famtastic_admin_preprocess_html(array &$variables): void {
  $route_name = \Drupal::routeMatch()->getRouteName();
  if (in_array($route_name, ['user.login', 'user.pass', 'user.reset', 'user.reset.login'], TRUE)) {
    $variables['attributes']['class'][] = 'famtastic-auth-page';
  }
  $route = \Drupal::routeMatch()->getRouteObject();
  if ($route && $route->getOption('_admin_route')) {
    $variables['attributes']['class'][] = 'famtastic-admin-shell';
  }
}

/**
 * Implements hook_theme_suggestions_page_alter().
 *
 * The shell template preserves standard Drupal regions and render primitives;
 * it is selected for all native administration routes, including future
 * standards-compliant modules.
 */
function famtastic_admin_theme_suggestions_page_alter(array &$suggestions, array $variables): void {
  $route_name = \Drupal::routeMatch()->getRouteName();
  if (in_array($route_name, ['user.login', 'user.pass', 'user.reset', 'user.reset.login'], TRUE)) {
    $suggestions[] = 'page__famtastic_auth';
  }
  $route = \Drupal::routeMatch()->getRouteObject();
  if ($route && $route->getOption('_admin_route')) {
    $suggestions[] = 'page__famtastic_admin';
  }
}


<?php

/**
 * @file
 * FAMtastic Admin theme hooks.
 *
 * Dark + lime brand layer on top of Claro. Intentionally minimal: all of the
 * visual work lives in css/famtastic-admin.css, delivered via the
 * "global-styling" library.
 */

declare(strict_types=1);

/**
 * Implements hook_preprocess_page().
 *
 * Attaches the brand stylesheet to every page rendered by this theme. The
 * library is already auto-attached via the "libraries" key in
 * famtastic_admin.info.yml; attaching it here as well is harmless (Drupal
 * de-duplicates identical library attachments) and guarantees the CSS is
 * present on admin pages rendered outside the standard page template.
 */
function famtastic_admin_preprocess_page(array &$variables): void {
  $variables['#attached']['library'][] = 'famtastic_admin/global-styling';
}


<?php

/**
 * @file
 * Route-scoped presentation; native forms, access and Commerce remain unchanged.
 */
declare(strict_types=1);

/** Implements hook_theme_suggestions_page_alter(). */
function famtastic_customer_theme_suggestions_page_alter(array &$suggestions, array $variables): void {
  if (\Drupal::routeMatch()->getRouteName() === 'famtastic_pipeline.private_purchase') {
    $suggestions[] = 'page__famtastic_private_purchase';
  }
}

/** Implements hook_preprocess_page(). */
function famtastic_customer_preprocess_page(array &$variables): void {
  if (\Drupal::routeMatch()->getRouteName() !== 'famtastic_pipeline.private_purchase') return;
  $variables['famtastic_logo_url'] = $variables['base_path'] . $variables['directory'] . '/famtastic-designs-logo-v1.png';
  // One canonical credit primitive, using a byte-identical local asset.
  $variables['famtastic_creator_credit'] = [
    '#markup' => \Drupal\Core\Render\Markup::create(str_replace(
      'https://famtasticdesigns.com/brand/famtastic-designs-logo-v1.png',
      $variables['famtastic_logo_url'],
      \Drupal\famtastic_pipeline\Service\CreatorCredit::html(),
    )),
  ];
}

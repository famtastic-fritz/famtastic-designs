      'payload' => $long,
      'occurred_at' => $time,
      'recorded_at' => $time,
    ],
    'primary key' => ['id'],
    'unique keys' => ['event_key' => ['event_key']],
    'indexes' => [
      'type_time' => ['event_type', 'occurred_at'],
      'prospect_time' => ['prospect_id', 'occurred_at'],
      'campaign_time' => ['campaign_id', 'occurred_at'],

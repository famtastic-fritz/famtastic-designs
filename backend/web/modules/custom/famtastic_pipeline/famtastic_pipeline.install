/**
 * Defines the lead import table independently for update-hook reuse.
 */
function _famtastic_pipeline_lead_import_schema(): array {
  return [
    'description' => 'Normalized lead source, dedupe, qualification, and import result.',
    'fields' => [
      'id' => ['type' => 'serial', 'unsigned' => TRUE, 'not null' => TRUE],
      'import_key' => ['type' => 'varchar', 'length' => 191, 'not null' => TRUE],

/** Adds owner-gated proofs, reference assets, and scoped grant codes. */
function famtastic_pipeline_update_8029(&$sandbox) {
  $schema = \Drupal::database()->schema();
  $requestDefinition = _famtastic_pipeline_customer_portal_schema()['famtastic_project_request'];
  foreach ([
    'proof_campaign_id', 'proof_review_status', 'proof_approved_by_uid',
    'proof_approved_at', 'proof_notified_at', 'selected_proof_direction',
    'selected_proof_at',
  ] as $field) {
    if (!$schema->fieldExists('famtastic_project_request', $field)) {
      $schema->addField('famtastic_project_request', $field, $requestDefinition['fields'][$field]);
    }
  }
  foreach (['famtastic_request_asset', 'famtastic_grant_code', 'famtastic_grant_redemption'] as $table) {
    if (!$schema->tableExists($table)) {
      $schema->createTable($table, _famtastic_pipeline_customer_portal_schema()[$table]);
    }
  }
  $settings = \Drupal::configFactory()->getEditable('famtastic_pipeline.settings');
  $currentNotificationAddress = mb_strtolower(trim((string) $settings->get('notification_to_email')));
  if ($currentNotificationAddress === '' || $currentNotificationAddress === 'fritz.medine@gmail.com') {
    $settings->set('notification_to_email', 'fitzgerald.medine@gmail.com')->save();
    \Drupal::database()->update('famtastic_notification_outbox')
      ->fields(['recipient' => 'fitzgerald.medine@gmail.com', 'changed' => \Drupal::time()->getRequestTime()])
      ->condition('recipient', 'fritz.medine@gmail.com')
      ->condition('category', 'operational')
      ->condition('status', ['queued', 'retry'], 'IN')
      ->execute();
  }
  return t('Added owner-gated request proofs, private reference assets, scoped grant codes, and corrected the operational alert inbox.');
}

/** Blocks direct web access to account-owned proof artifacts. */
function famtastic_pipeline_update_8030(&$sandbox) {
  $database = \Drupal::database();
  $rows = $database->select('famtastic_project_request', 'r')
    ->fields('r', ['id', 'proof_campaign_id'])
    ->isNotNull('proof_campaign_id')
    ->execute()
    ->fetchAllAssoc('proof_campaign_id', \PDO::FETCH_ASSOC);
  if (!$rows) {
    return t('No account-owned proof artifacts required protection.');
  }
  $campaigns = \Drupal::entityTypeManager()->getStorage('proof_campaign')->loadMultiple(array_keys($rows));
  $variantStorage = \Drupal::entityTypeManager()->getStorage('proof_variant');
  $rules = "<IfModule mod_authz_core.c>\n  Require all denied\n</IfModule>\n<IfModule !mod_authz_core.c>\n  Order allow,deny\n  Deny from all\n</IfModule>\n";
  $secured = 0;
  foreach ($campaigns as $campaignEntityId => $campaign) {
    $requestId = (int) $rows[$campaignEntityId]['id'];
    $campaignId = preg_replace('/[^a-z0-9-]/', '', strtolower((string) $campaign->get('campaign_id')->value));
    if ($campaignId === '') {
      continue;
    }
    $directory = \Drupal::root() . '/proofs/' . $campaignId;
    if (!is_dir($directory) || file_put_contents($directory . '/.htaccess', $rules, LOCK_EX) === FALSE) {
      throw new \RuntimeException('Unable to secure account proof campaign ' . $campaignId . '.');
    }
    $ids = $variantStorage->getQuery()->accessCheck(FALSE)->condition('campaign_id', (int) $campaignEntityId)->execute();
    foreach ($variantStorage->loadMultiple($ids) as $variant) {
      $direction = (string) $variant->get('direction_id')->value;
      $variant->set('preview_url', '/web/admin/famtastic/website-request/' . $requestId . '/proof/' . $direction)->save();
    }
    $secured++;
  }
  return t('Protected @count account-owned proof campaign(s) from direct web access.', ['@count' => $secured]);
}

/** Gives the configured owner inbox a narrowly scoped proof-review role. */
function famtastic_pipeline_update_8031(&$sandbox) {
  $roleStorage = \Drupal::entityTypeManager()->getStorage('user_role');
  $role = $roleStorage->load('famtastic_proof_reviewer');
  if (!$role) {
    $role = $roleStorage->create([
      'id' => 'famtastic_proof_reviewer',
      'label' => 'FAMtastic proof reviewer',
    ]);
  }
  $role->grantPermission('review famtastic website proofs')->save();
  $ownerEmail = mb_strtolower(trim((string) \Drupal::config('famtastic_pipeline.settings')->get('notification_to_email')));
  if ($ownerEmail === '') {
    return t('Created the proof-review role; no operational owner email is configured for assignment.');
  }
  $userStorage = \Drupal::entityTypeManager()->getStorage('user');
  $ids = $userStorage->getQuery()->accessCheck(FALSE)->condition('mail', $ownerEmail)->condition('status', 1)->execute();
  if (count($ids) !== 1) {
    return t('Created the proof-review role; no unique active account matched the configured owner email.');
  }
  $owner = $userStorage->load(reset($ids));
  $owner->addRole('famtastic_proof_reviewer')->save();
  return t('Assigned narrowly scoped website proof-review access to the configured operational owner.');
}

/** Adds revocable, unlisted sharing for owner-approved website proof sets. */
function famtastic_pipeline_update_8032(&$sandbox) {
  $schema = \Drupal::database()->schema();
  $requestDefinition = _famtastic_pipeline_customer_portal_schema()['famtastic_project_request'];
  foreach (['proof_share_enabled', 'proof_share_version', 'proof_share_changed_at', 'proof_share_changed_by_uid'] as $field) {
    if (!$schema->fieldExists('famtastic_project_request', $field)) {
      $schema->addField('famtastic_project_request', $field, $requestDefinition['fields'][$field]);
    }
  }
  return t('Added revocable, non-indexable sharing controls for approved website proofs.');
}

/** Preserves v3 and creates the approved v4 terms snapshot. */
function _famtastic_pipeline_seed_customer_terms_v4(): void {
  _famtastic_pipeline_seed_customer_terms_v3();
  $database = \Drupal::database();
  $v3 = $database->select('famtastic_terms_version', 't')->fields('t')->condition('terms_key', 'website_service')->condition('version', 3)->execute()->fetchAssoc();
  if (!$v3) throw new \RuntimeException('customer_terms_v3_missing');
  $body = str_replace(
    ['Provisional Business Policy v3', 'STATUS. This is a provisional business policy for test-mode implementation. It\nis not represented as attorney-approved. Qualified legal review and final owner\napproval remain required before live recurring charges or unrestricted public\ncheckout.'],
    ['Approved Customer Policy v4', 'STATUS. Fritz Medine recorded final legal and business approval for this customer policy. Live charging remains separately gated by provider, checkout, notification, and launch acceptance evidence.'],
    (string) $v3['body'],
  );
  $database->update('famtastic_terms_version')->fields(['active' => 0])->condition('terms_key', 'website_service')->execute();
  $database->merge('famtastic_terms_version')->key('terms_key', 'website_service')->key('version', 4)->fields([
    'checksum' => hash('sha256', $body), 'document_url' => '/terms/website-service-v4', 'body' => $body,
    'effective_at' => \Drupal::time()->getRequestTime(), 'active' => 1, 'created' => \Drupal::time()->getRequestTime(),
  ])->execute();
}

/** Seeds the immutable v3 operational draft without representing legal approval. */
function _famtastic_pipeline_seed_customer_terms_v3(): void {
  $body = <<<'TERMS'
FAMtastic Designs Customer Service Terms — Provisional Business Policy v3

ORDER AND SCOPE. The checkout summary identifies every product and add-on by
name, SKU, price, scope version, included deliverables, exclusions, intake,
revision allowance, and delivery milestones. That accepted snapshot controls
the order. Anything outside it requires a separately priced and accepted add-on
or change order. FAMtastic normally responds within three business days; this is
a response target, not a guaranteed completion or resolution time.

WEB BASICS BUNDLE. The $199 Web Basics Bundle purchases one custom, focused
single-page or landing-page website. It includes twelve months of basic
FAMtastic-managed hosting beginning at launch. If the customer needs a domain,
it also includes first-year registration of one standard, available domain. A
premium, aftermarket, brokered, or unusually priced domain is not included and
will not be purchased without a separate quote and approval. A customer who
already controls a domain receives domain connection instead of a new domain.

OWNERSHIP AND HOSTING. The customer owns customer-supplied content and any
domain registered for the customer. FAMtastic owns and manages its hosting
infrastructure and may deliver hosting under FAMtastic branding or a white-label
presentation. The customer receives the service and access described by the
order, not ownership of the underlying shared server account or infrastructure.

HOSTING RENEWAL. After the included first year, basic hosting is $9.99 per month.
It will begin only after the customer separately authorizes the amount, monthly
frequency, start date, and cancellation method. The authorization and exact
wording are recorded. The customer may cancel before the next billing date to
stop future charges. Service remains available through the paid period; completed
hosting periods are not prorated. Failed payments enter notice, retry, grace,
and possible suspension workflows before service is ended.

DOMAIN RENEWAL. A new domain's next registration year is due prepaid at the
beginning of year two, and annually thereafter. The registrar price and due date
will be disclosed before payment because registry pricing varies. Domain renewal
is separate from hosting. Existing-domain customers are not charged a domain
renewal by FAMtastic. A domain is not renewed or purchased without the recorded
authority and payment required for that transaction.

CANCELLATION AND REFUNDS. Before FAMtastic begins work, the FAMtastic service
price is refundable. Once work begins, completed work may be deducted from any
approved refund. Completed milestones, delivered digital work, registered
domains, and other irreversible third-party costs are nonrefundable. Recurring
services may be cancelled before the next billing date; cancellation stops
future charges and does not reverse service already delivered. Product-specific
rules shown in the accepted deal snapshot supplement this policy.

CUSTOMER RESPONSIBILITIES. The customer confirms authority to supply content,
brands, accounts, domains, instructions, and personal data used for the work.
The customer is responsible for factual and legal accuracy of supplied content
and for timely intake, review, and approvals. Proof approval authorizes launch
of that release. AI, analytics, SEO, advertising, automation, and third-party
services do not guarantee traffic, rankings, sales, error-free output, or
continuous availability unless an order expressly says otherwise.

PAYMENTS AND COMMUNICATIONS. Stripe handles payment methods; FAMtastic does not
store full card numbers. Transactional security, account, project, support,
billing, and renewal messages may be sent as needed to operate purchased
services. Promotional education, deals, and offers require a separate choice
and can be disabled without stopping transactional messages.

FAMtastic Designs, 1729 NW St. Lucie West Blvd #1181, Port Saint Lucie, Florida
34986, United States.

STATUS. This is a provisional business policy for test-mode implementation. It
is not represented as attorney-approved. Qualified legal review and final owner
approval remain required before live recurring charges or unrestricted public
checkout.
TERMS;
  $database = \Drupal::database();
  $database->update('famtastic_terms_version')->fields(['active' => 0])->condition('terms_key', 'website_service')->execute();
  $database->merge('famtastic_terms_version')->key('terms_key', 'website_service')->key('version', 3)->fields([
    'checksum' => hash('sha256', $body), 'document_url' => '/terms/website-service-v3', 'body' => $body,
    'effective_at' => 0, 'active' => 1, 'created' => \Drupal::time()->getRequestTime(),
  ])->execute();
}

/**
 * Seeds versioned commercial facts without overwriting existing versions.
 */
function _famtastic_pipeline_seed_commercial_versions(): void {
  $database = \Drupal::database();
  $now = \Drupal::time()->getRequestTime();
  $offers = [
    'essential_199' => [
      'name' => 'Essential Launch',
      'amount_minor' => 19900,
      'included_revisions' => 1,
      'definition' => [
        'one_page_site',
        'five_content_sections',
        'mobile_responsive',
        'ssl',
        'twelve_months_hosting',
      ],
    ],
    'business_499' => [
      'name' => 'Business Launch',
      'amount_minor' => 49900,
      'included_revisions' => 2,
      'definition' => [
        'essential_launch',
        'lead_capture',
        'seo_setup',
        'analytics',
        'custom_domain_connection',
        'twelve_months_hosting',
      ],
    ],
    'revision_addon_75' => [
      'name' => 'Additional revision',
      'amount_minor' => 7500,
      'included_revisions' => 1,
      'definition' => ['one_additional_revision_round'],
    ],
  ];
  foreach ($offers as $offerKey => $offer) {
    $database->merge('famtastic_offer_version')
      ->key('offer_key', $offerKey)
      ->key('version', 1)
      ->insertFields([
        'offer_key' => $offerKey,
        'version' => 1,
        'name' => $offer['name'],
        'amount_minor' => $offer['amount_minor'],
        'currency' => 'usd',
        'included_revisions' => $offer['included_revisions'],
        'hosting_months' => str_starts_with($offerKey, 'revision_') ? 0 : 12,
        'active' => 1,
        'definition' => json_encode($offer['definition'], JSON_THROW_ON_ERROR),
        'created' => $now,
      ])
      ->execute();
  }

  $termsBody = <<<'TERMS'
FAMtastic Designs Website Service Terms v1

The selected launch package, included work, revision allowance, and price are
shown before checkout. The customer confirms they are authorized to supply the
business content and assets. The customer owns their supplied content and
controls their domain. FAMtastic receives only the permission needed to build,
host, and support the site.

The purchase includes twelve months of hosting beginning at launch. Continued
hosting after that period requires separately disclosed recurring billing
authorization and may be cancelled before renewal. Domain registration or DNS
management performed by FAMtastic is delegated work for the customer and does
not transfer domain ownership to FAMtastic.

Package-specific revision limits apply. Additional work requires a separately
accepted add-on. Acceptance of a proof authorizes deployment of that release.

This operational draft must be reviewed by qualified counsel before live sales.
TERMS;
  $checksum = hash('sha256', $termsBody);
  $database->merge('famtastic_terms_version')
    ->key('terms_key', 'website_service')
    ->key('version', 1)
    ->insertFields([
      'terms_key' => 'website_service',
      'version' => 1,
      'checksum' => $checksum,
      'document_url' => '/terms/website-service-v1',
      'body' => $termsBody,
      'effective_at' => $now,
      'active' => 1,
      'created' => $now,
    ])
    ->execute();
}

/**
 * Defines normalized operational records used across the autonomous pipeline.
 */
function _famtastic_pipeline_automation_schema(): array {
  $id = [
    'type' => 'serial',
    'unsigned' => TRUE,
    'not null' => TRUE,
  ];
  $entityId = [
    'type' => 'int',
    'unsigned' => TRUE,
    'not null' => FALSE,
  ];
  $short = [
    'type' => 'varchar',
    'length' => 128,
    'not null' => TRUE,
    'default' => '',
  ];
  $long = [
    'type' => 'text',
    'size' => 'big',
    'not null' => FALSE,
  ];
  $time = [
    'type' => 'int',
    'unsigned' => TRUE,
    'not null' => TRUE,
    'default' => 0,
  ];

  $tables['famtastic_campaign'] = [
    'description' => 'Versioned outreach campaigns and aggregate cost.',
    'fields' => [
      'id' => $id,
      'campaign_key' => $short,
      'name' => ['type' => 'varchar', 'length' => 255, 'not null' => TRUE],
      'status' => $short,
      'channel' => $short,
      'source_filter' => $long,
      'budget_minor' => ['type' => 'int', 'not null' => TRUE, 'default' => 0],
      'spent_minor' => ['type' => 'int', 'not null' => TRUE, 'default' => 0],
      'currency' => ['type' => 'varchar', 'length' => 8, 'not null' => TRUE, 'default' => 'usd'],
      'created' => $time,
      'changed' => $time,
    ],
    'primary key' => ['id'],
    'unique keys' => ['campaign_key' => ['campaign_key']],
    'indexes' => ['status' => ['status']],
  ];

  $tables['famtastic_offer_version'] = [
    'description' => 'Immutable commercial offer versions.',
    'fields' => [
      'id' => $id,
      'offer_key' => $short,
      'version' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
      'name' => ['type' => 'varchar', 'length' => 255, 'not null' => TRUE],
      'amount_minor' => ['type' => 'int', 'not null' => TRUE],
      'currency' => ['type' => 'varchar', 'length' => 8, 'not null' => TRUE, 'default' => 'usd'],
      'included_revisions' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
      'hosting_months' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE, 'default' => 12],
      'active' => ['type' => 'int', 'size' => 'tiny', 'not null' => TRUE, 'default' => 1],
      'definition' => $long,
      'created' => $time,
    ],
    'primary key' => ['id'],
    'unique keys' => ['offer_version' => ['offer_key', 'version']],
    'indexes' => ['active_offer' => ['offer_key', 'active']],
  ];

  $tables['famtastic_terms_version'] = [
    'description' => 'Immutable customer terms and policy snapshots.',
    'fields' => [
      'id' => $id,
      'terms_key' => $short,
      'version' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
      'checksum' => ['type' => 'varchar', 'length' => 64, 'not null' => TRUE],
      'document_url' => ['type' => 'varchar', 'length' => 1024, 'not null' => TRUE],
      'body' => $long,
      'effective_at' => $time,
      'active' => ['type' => 'int', 'size' => 'tiny', 'not null' => TRUE, 'default' => 1],
      'created' => $time,
    ],
    'primary key' => ['id'],
    'unique keys' => [
      'terms_version' => ['terms_key', 'version'],
      'checksum' => ['checksum'],
    ],
  ];

  $tables['famtastic_consent'] = [
    'description' => 'Auditable consent, terms acceptance, and suppression records.',
    'fields' => [
      'id' => $id,
      'prospect_id' => $entityId,
      'contact_hash' => ['type' => 'varchar', 'length' => 64, 'not null' => TRUE],
      'consent_type' => $short,
      'status' => $short,
      'terms_version_id' => $entityId,
      'evidence' => $long,
      'ip_hash' => ['type' => 'varchar', 'length' => 64, 'not null' => TRUE, 'default' => ''],
      'user_agent_hash' => ['type' => 'varchar', 'length' => 64, 'not null' => TRUE, 'default' => ''],
      'recorded_at' => $time,
      'revoked_at' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => FALSE],
    ],
    'primary key' => ['id'],
    'indexes' => [
      'contact_status' => ['contact_hash', 'consent_type', 'status'],
      'prospect' => ['prospect_id'],
    ],
  ];

  $tables['famtastic_event'] = [
    'description' => 'Append-only business and provider event ledger.',
    'fields' => [
      'id' => ['type' => 'serial', 'size' => 'big', 'unsigned' => TRUE, 'not null' => TRUE],
      'event_key' => ['type' => 'varchar', 'length' => 191, 'not null' => TRUE],

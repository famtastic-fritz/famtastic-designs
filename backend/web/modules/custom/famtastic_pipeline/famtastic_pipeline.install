  }
  return t('The famtastic_customer role already exists.');
}

/**
 * Adds owner-gated public proof deliveries without colliding with prior 8033.
 *
 * This update intentionally creates the preview table from its nested table
 * definition. A prior feature branch passed the entire schema map to
 * createTable(), which would not be a valid Drupal table definition.
 */
function famtastic_pipeline_update_8041(&$sandbox) {
  $database = \Drupal::database();
  $schema = $database->schema();
  $definitions = _famtastic_pipeline_preview_delivery_schema();
  $definition = $definitions['famtastic_preview_delivery'];
  if (!$schema->tableExists('famtastic_preview_delivery')) {
    $schema->createTable('famtastic_preview_delivery', $definition);
    return t('Added owner-gated public preview delivery, research snapshot, and account-claim records.');
  }

  // A previous incomplete attempt may have left a table behind. Validate all
  // non-reconstructable data before issuing any DDL: Drupal's MySQL Schema API
  // temporarily permits NULL while adding a required field, then restores its
  // NOT NULL constraint. That cannot safely work for an existing row without
  // either a defined initial value or an explicit operator repair.
  $row_count = (int) $database->select('famtastic_preview_delivery', 'delivery')
    ->countQuery()
    ->execute()
    ->fetchField();
  $missing_fields = [];
  foreach ($definition['fields'] as $name => $field) {
    if (!$schema->fieldExists('famtastic_preview_delivery', $name)) {
      $missing_fields[$name] = $field;
    }
  }
  $safe_initial_values = [
    // An un-staged legacy delivery has no frozen email body. An empty snapshot
    // is an honest migration value; sending remains gated by a later stage.
    'text_snapshot' => '',
  ];
  if ($row_count > 0) {
    $unsafe_fields = [];
    foreach ($missing_fields as $name => $field) {
      if (!empty($field['not null']) && !array_key_exists('default', $field) && !array_key_exists($name, $safe_initial_values)) {
        $unsafe_fields[] = $name;
      }
    }
    if ($unsafe_fields) {
      throw new \Drupal\Core\Utility\UpdateException(sprintf(
        'famtastic_preview_delivery has %d existing row(s) but is missing required fields (%s). No schema changes were made. Repair or map those legacy records before rerunning update 8041.',
        $row_count,
        implode(', ', $unsafe_fields),
      ));
    }
    // The three ownership/idempotency identifiers must already be usable on
    // every legacy row before this update can add uniqueness or harden their
    // column definitions. A nullable/blank identity would evade a MySQL
    // unique key and turn a partial migration into an unclaimable or
    // cross-delivery record. Never repair or invent those values here.
    foreach (['public_id', 'delivery_key', 'prospect_id'] as $identity_field) {
      if (!isset($definition['fields'][$identity_field]) || isset($missing_fields[$identity_field])) {
        // A missing required identity is already covered by the no-DDL
        // unsafe-field failure above; retain this guard for future schema
        // changes that might make that field conditionally required.
        throw new \Drupal\Core\Utility\UpdateException(sprintf(
          'famtastic_preview_delivery is missing its required %s identity field. No schema changes were made.',
          $identity_field,
        ));
      }
      $invalid_identity = $database->select('famtastic_preview_delivery', 'delivery');
      $invalid_identity->addField('delivery', 'id');
      $invalid = $invalid_identity->orConditionGroup()
        ->isNull('delivery.' . $identity_field);
      if ($identity_field === 'prospect_id') {
        $invalid->condition('delivery.' . $identity_field, 0, '<=');
      }
      else {
        $invalid->condition('delivery.' . $identity_field, '');
      }
      $invalid_identity->condition($invalid)->range(0, 1);
      if ($invalid_identity->execute()->fetchField() !== FALSE) {
        throw new \Drupal\Core\Utility\UpdateException(sprintf(
          'famtastic_preview_delivery contains a blank, NULL, or invalid %s identity. No schema changes were made. Repair the legacy record before rerunning update 8041.',
          $identity_field,
        ));
      }
    }
    foreach ($definition['unique keys'] as $name => $fields) {
      if ($schema->indexExists('famtastic_preview_delivery', $name)) {
        continue;
      }
      $duplicate_query = $database->select('famtastic_preview_delivery', 'delivery');
      foreach ($fields as $field) {
        $duplicate_query->addField('delivery', $field);
        $duplicate_query->groupBy('delivery.' . $field);
      }
      $duplicate_query->having('COUNT(*) > 1');
      $duplicate_query->range(0, 1);
      if ($duplicate_query->execute()->fetchField() !== FALSE) {
        throw new \Drupal\Core\Utility\UpdateException(sprintf(
          'famtastic_preview_delivery contains duplicate values for the required %s key. No schema changes were made. Deduplicate the legacy records before rerunning update 8041.',
          $name,
        ));
      }
    }
  }
  foreach ($definition['fields'] as $name => $field) {
    if (isset($missing_fields[$name])) {
      if (array_key_exists($name, $safe_initial_values)) {
        $field['initial'] = $safe_initial_values[$name];
      }
      $schema->addField('famtastic_preview_delivery', $name, $field);
    }
  }
  // Existing partial tables may carry nullable identity columns even when
  // their values are currently valid. Lock them to the canonical definitions
  // before adding the unique keys, so future rows cannot recreate the same
  // ambiguous state.
  foreach (['public_id', 'delivery_key', 'prospect_id'] as $identity_field) {
    if (!isset($missing_fields[$identity_field])) {
      $schema->changeField(
        'famtastic_preview_delivery',
        $identity_field,
        $identity_field,
        $definition['fields'][$identity_field],
      );
    }
  }
  foreach ($definition['indexes'] as $name => $fields) {
    if (!$schema->indexExists('famtastic_preview_delivery', $name)) {
      $schema->addIndex('famtastic_preview_delivery', $name, $fields, $definition);
    }
  }
  // A stale partial-table attempt may have created fields without the two
  // idempotency keys. Upgrade it rather than silently accepting duplicate
  // public IDs or delivery keys on production MySQL.
  foreach ($definition['unique keys'] as $name => $fields) {
    if (!$schema->indexExists('famtastic_preview_delivery', $name)) {
      $schema->addUniqueKey('famtastic_preview_delivery', $name, $fields);
    }
  }
  return t('Updated public preview delivery records with the current schema.');
}

/**
 * Fails before any 8042 DDL when a populated cold table cannot receive its
 * declared immutable identity fields and unique keys safely.
 */
function _famtastic_pipeline_assert_cold_proof_schema_preflight($database, $schema, array $definitions): void {
  foreach ($definitions as $table => $definition) {
    if (!$schema->tableExists($table) || !(bool) $database->select($table, 't')->countQuery()->execute()->fetchField()) {
      continue;
    }
    $unsafe = [];
    foreach ($definition['fields'] as $name => $field) {
      if (
        !$schema->fieldExists($table, $name)
        && !empty($field['not null'])
        && !array_key_exists('default', $field)
      ) {
        $unsafe[] = $name;
      }
    }
    // A preexisting partial table can have the identity columns while still
    // lack their declared unique keys. Check every existing value before DDL:
    // adding a key after a late duplicate/null failure would leave an
    // ambiguous cohort or ingress identity in a half-upgraded table. These
    // field names come only from the module schema, never user input.
    foreach ((array) ($definition['unique keys'] ?? []) as $keyName => $keyFields) {
      $keyFields = array_values((array) $keyFields);
      $allFieldsExist = $keyFields !== [];
      foreach ($keyFields as $field) {
        if (!$schema->fieldExists($table, $field)) {
          $unsafe[] = 'unique key ' . $keyName . ' missing field ' . $field;
          $allFieldsExist = FALSE;
          continue;
        }
        $values = $database->select($table, 't')->fields('t', [$field])->execute()->fetchCol();
        foreach ($values as $value) {
          if ($value === NULL || trim((string) $value) === '') {
            $unsafe[] = 'unique key ' . $keyName . ' has NULL/empty ' . $field;
            break;
          }
        }
      }
      if (!$allFieldsExist) {
        continue;
      }
      $duplicates = $database->select($table, 't')->fields('t', $keyFields);
      $duplicates->addExpression('COUNT(*)', 'famtastic_duplicate_count');
      foreach ($keyFields as $field) {
        $duplicates->groupBy($field);
      }
      if ($duplicates->having('COUNT(*) > 1')->range(0, 1)->execute()->fetchAssoc()) {
        $unsafe[] = 'duplicate values for unique key ' . $keyName;
      }
    }
    if ($unsafe) {
      throw new \RuntimeException(sprintf(
        'Cannot safely extend populated %s; required identity fields or unique keys are missing, blank, or duplicated: %s. Repair or export the malformed historical table before rerunning update 8042.',
        $table,
        implode(', ', $unsafe),
      ));
    }
  }
}

/** Adds frozen cold-cohort contracts and scheduled owner-gated release state. */
function famtastic_pipeline_update_8042(&$sandbox) {
  $database = \Drupal::database();
  $schema = $database->schema();
  $cold = _famtastic_pipeline_cold_proof_schema();
  // Run this before any 8042 schema mutation, including unrelated additive
  // fields, so a malformed cold identity table cannot leave a partial update.
  _famtastic_pipeline_assert_cold_proof_schema_preflight($database, $schema, $cold);
  $preview = _famtastic_pipeline_preview_delivery_schema()['famtastic_preview_delivery'];
  foreach ($preview['fields'] as $name => $field) {
    if (!$schema->fieldExists('famtastic_preview_delivery', $name)) {
      $schema->addField('famtastic_preview_delivery', $name, $field);
    }
  }
  foreach ($preview['indexes'] as $name => $fields) {
    if (!$schema->indexExists('famtastic_preview_delivery', $name)) {
      $schema->addIndex('famtastic_preview_delivery', $name, $fields, $preview);
    }
  }
  $messages = _famtastic_pipeline_email_message_schema();
  foreach ($messages['fields'] as $name => $field) {
    if (!$schema->fieldExists('famtastic_email_message', $name)) {
      $schema->addField('famtastic_email_message', $name, $field);
    }
  }
  foreach ($messages['indexes'] as $name => $fields) {
    if (!$schema->indexExists('famtastic_email_message', $name)) {
      $schema->addIndex('famtastic_email_message', $name, $fields, $messages);
    }
  }
  foreach ($cold as $table => $definition) {
    if (!$schema->tableExists($table)) {
      $schema->createTable($table, $definition);
      continue;
    }
    foreach ($definition['fields'] as $name => $field) {
      if (!$schema->fieldExists($table, $name)) {
        // New link fields are intentionally nullable. A pre-feature table can
        // contain historical imports with no safely reconstructable campaign
        // identity; those rows remain non-exportable rather than being mapped
        // to an invented campaign during an update.
        $schema->addField($table, $name, $field);
      }
    }
    // A MySQL unique index permits multiple NULL values. Once preflight has
    // proven the historical values are present and unambiguous, restore the
    // immutable unique-key columns to their canonical NOT NULL definitions so
    // a partially upgraded table cannot accept new blank identities later.
    foreach ((array) ($definition['unique keys'] ?? []) as $keyFields) {
      foreach ((array) $keyFields as $field) {
        if (isset($definition['fields'][$field]) && $schema->fieldExists($table, $field)) {
          $schema->changeField($table, $field, $field, $definition['fields'][$field]);
        }
      }
    }
    foreach ($definition['indexes'] as $name => $fields) {
      if (!$schema->indexExists($table, $name)) {
        $schema->addIndex($table, $name, $fields, $definition);
      }
    }
    foreach ((array) ($definition['unique keys'] ?? []) as $name => $fields) {
      if (!$schema->indexExists($table, $name)) {
        $schema->addUniqueKey($table, $name, $fields);
      }
    }
  }
  return t('Added verified cold-proof cohort records, frozen direction profiles, and scheduled owner-gated release fields.');
}

/**
 * Restores the default public proof cohort config on upgraded installations.
 *
 * The profile was introduced as module install configuration. Drupal only
 * applies config/install files when a module is first enabled, so an existing
 * FAMtastic install can have the new public-preview schema while still lack
 * the profile that every public proof delivery resolves. Only a wholly absent
 * config object is restored here: a real operator configuration is never
 * replaced or merged by an update hook.
 */
function famtastic_pipeline_update_8043(&$sandbox) {
  if (_famtastic_pipeline_seed_default_proof_cohort_config()) {
    return t('Restored the default anonymous public proof cohort profile for this upgraded installation.');
  }
  return t('Preserved the existing anonymous public proof cohort configuration.');
}

/** Adds owner-invited, token-scoped deep discovery records. */
function famtastic_pipeline_update_8045(&$sandbox) {
  $schema = \Drupal::database()->schema();
  $definition = _famtastic_pipeline_deep_dive_invitation_schema();
  if (!$schema->tableExists('famtastic_deep_dive_invitation')) {
    $schema->createTable('famtastic_deep_dive_invitation', $definition);
    return t('Created private deep-dive invitation records.');
  }
  foreach ($definition['fields'] as $field => $specification) {
    if (!$schema->fieldExists('famtastic_deep_dive_invitation', $field)) {
      $schema->addField('famtastic_deep_dive_invitation', $field, $specification);
    }
  }
  foreach ($definition['indexes'] as $name => $fields) {
    if (!$schema->indexExists('famtastic_deep_dive_invitation', $name)) {
      $schema->addIndex('famtastic_deep_dive_invitation', $name, $fields, $definition);
    }
  }
  foreach ($definition['unique keys'] as $name => $fields) {
    if (!$schema->indexExists('famtastic_deep_dive_invitation', $name)) {
      $schema->addUniqueKey('famtastic_deep_dive_invitation', $name, $fields);
    }
  }
  return t('Extended private deep-dive invitation records.');
}

/** Adds safe, auditable deep-dive email template snapshots. */
function famtastic_pipeline_update_8047(&$sandbox) {
  $schema = \Drupal::database()->schema();
  $table = 'famtastic_deep_dive_invitation';
  if (!$schema->tableExists($table)) {
    return t('Deep-dive invitation table is not installed yet.');
  }
  $fields = [
    'email_subject_template' => ['type' => 'varchar', 'length' => 512, 'not null' => TRUE, 'default' => ''],
    // This deliberately retains {{interview_url}}, not the bearer URL itself.
    'email_body_template' => ['type' => 'text', 'size' => 'big', 'not null' => FALSE],
  ];
  foreach ($fields as $field => $definition) {
    if (!$schema->fieldExists($table, $field)) {
      $schema->addField($table, $field, $definition);
    }
  }
  return t('Added deep-dive email template snapshots without storing bearer links.');
}

/** Defines secure, private discovery interviews that can later be account-claimed. */
function _famtastic_pipeline_deep_dive_invitation_schema(): array {
  $time = ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE, 'default' => 0];
  return [
    'description' => 'Owner-invited, token-scoped deep website discovery interviews. No raw bearer secret is stored.',
    'fields' => [
      'id' => ['type' => 'serial', 'unsigned' => TRUE, 'not null' => TRUE],
      'public_id' => ['type' => 'varchar', 'length' => 36, 'not null' => TRUE],
      'prospect_id' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => FALSE],
      'customer_id' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => FALSE],
      'website_request_id' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => FALSE],
      'email' => ['type' => 'varchar', 'length' => 320, 'not null' => TRUE],
      'business_name' => ['type' => 'varchar', 'length' => 255, 'not null' => TRUE],
      'contact_name' => ['type' => 'varchar', 'length' => 255, 'not null' => TRUE, 'default' => ''],
      'secret_hash' => ['type' => 'varchar', 'length' => 64, 'not null' => TRUE],
      'status' => ['type' => 'varchar', 'length' => 32, 'not null' => TRUE, 'default' => 'draft'],
      'answers' => ['type' => 'text', 'size' => 'big', 'not null' => TRUE],
      'email_subject_template' => ['type' => 'varchar', 'length' => 512, 'not null' => TRUE, 'default' => ''],
      'email_body_template' => ['type' => 'text', 'size' => 'big', 'not null' => FALSE],
      'provider_message_id' => ['type' => 'varchar', 'length' => 255, 'not null' => TRUE, 'default' => ''],
      'activated_at' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => FALSE],
      'sent_at' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => FALSE],
      'completed_at' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => FALSE],
      'claimed_at' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => FALSE],
      'created' => $time,
      'changed' => $time,
    ],
    'primary key' => ['id'],
    'unique keys' => ['public_id' => ['public_id'], 'secret_hash' => ['secret_hash']],
    'indexes' => [
      'email_status' => ['email', 'status'],
      'prospect' => ['prospect_id'],
      'customer' => ['customer_id'],
      'website_request' => ['website_request_id'],
    ],
  ];
}

/**
 * Creates the shipped proof cohort configuration only when it is absent.
 *
 * @return bool
 *   TRUE when the install configuration was restored; FALSE when an active
 *   configuration already existed.
 */
function _famtastic_pipeline_seed_default_proof_cohort_config(): bool {
  $config = \Drupal::configFactory()->getEditable('famtastic_pipeline.proof_cohorts');
  if ($config->getRawData() !== []) {
    return FALSE;
  }

  $module_path = \Drupal::service('extension.list.module')->getPath('famtastic_pipeline');
  $path = $module_path . '/config/install/famtastic_pipeline.proof_cohorts.yml';
  $yaml = @file_get_contents($path);
  if (!is_string($yaml) || $yaml === '') {
    throw new \RuntimeException('The default proof cohort configuration is unavailable for this update.');
  }
  $data = \Drupal\Component\Serialization\Yaml::decode($yaml);
  if (!is_array($data) || empty($data['anonymous']['default_profile']) || empty($data['anonymous']['profiles'])) {
    throw new \RuntimeException('The default proof cohort configuration is malformed.');
  }
  $config->setData($data)->save(TRUE);
  return TRUE;
}

/** Adds the dedicated small-business microsite content and capture store. */
function famtastic_pipeline_update_8044(&$sandbox) {
  $schema = \Drupal::database()->schema();
  $created = [];
  foreach (_famtastic_pipeline_microsite_schema() as $table => $definition) {
    if (!$schema->tableExists($table)) {
      $schema->createTable($table, $definition);
      $created[] = $table;
    }
  }
  _famtastic_pipeline_seed_microsite_defaults();
  return t('Added durable microsite content and inbound capture tables: @tables.', [
    '@tables' => $created ? implode(', ', $created) : 'none (already present)',
  ]);
}

/** Adds durable preorder and external-payment confirmation records. */
function famtastic_pipeline_update_8046(&$sandbox) {

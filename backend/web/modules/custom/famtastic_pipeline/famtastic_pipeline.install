/**
 * Defines the durable customer lifecycle and branded portal records.
 */
function _famtastic_pipeline_customer_portal_schema(): array {
  $id = ['type' => 'serial', 'unsigned' => TRUE, 'not null' => TRUE];
  $entity = ['type' => 'int', 'unsigned' => TRUE, 'not null' => FALSE];
  $time = ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE, 'default' => 0];
  $public = ['type' => 'varchar', 'length' => 36, 'not null' => TRUE];
  $status = ['type' => 'varchar', 'length' => 32, 'not null' => TRUE, 'default' => 'active'];

  $tables['famtastic_customer'] = [
    'description' => 'Durable customer identity linked to a Drupal user and acquisition history.',
    'fields' => [
      'id' => $id, 'public_id' => $public,
      'uid' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
      'prospect_id' => $entity,
      'commerce_profile_id' => $entity,
      'display_name' => ['type' => 'varchar', 'length' => 255, 'not null' => TRUE],
      'email' => ['type' => 'varchar', 'length' => 320, 'not null' => TRUE],
      'phone' => ['type' => 'varchar', 'length' => 64, 'not null' => TRUE, 'default' => ''],
      'acquisition_source' => ['type' => 'varchar', 'length' => 128, 'not null' => TRUE, 'default' => 'direct'],
      'marketing_status' => ['type' => 'varchar', 'length' => 32, 'not null' => TRUE, 'default' => 'subscribed'],
      'verified_at' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => FALSE],
      'created' => $time, 'changed' => $time,
    ],
    'primary key' => ['id'],
    'unique keys' => ['public_id' => ['public_id'], 'uid' => ['uid'], 'email' => ['email']],

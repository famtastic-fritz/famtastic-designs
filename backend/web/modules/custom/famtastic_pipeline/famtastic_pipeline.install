/**
 * Maps every known content_id to the campaign it belongs to, by reading
 * every campaign's posting-schedule.json plus the legacy 55-cents-17-day
 * manifest. Used only to backfill famtastic_social_record.campaign_id in
 * famtastic_pipeline_update_8048(); never used at request time.
 */
function _famtastic_pipeline_social_record_campaign_map(): array {
  $map = [];
  $roots = [
    dirname(\Drupal::root(), 2) . '/marketing/campaigns',
    dirname(\Drupal::root()) . '/marketing/campaigns',
    \Drupal::root() . '/../marketing/campaigns',
  ];
  $campaignsRoot = NULL;
  foreach ($roots as $candidate) {
    if (is_dir($candidate)) {
      $campaignsRoot = $candidate;
      break;
    }
  }
  if ($campaignsRoot === NULL) {
    return $map;
  }

  foreach (glob($campaignsRoot . '/*/posting-schedule.json') ?: [] as $path) {
    $decoded = json_decode((string) file_get_contents($path), TRUE);
    if (!is_array($decoded) || empty($decoded['campaign_id'])) {
      continue;
    }
    foreach ($decoded['drops'] ?? [] as $drop) {
      if (!empty($drop['content_id'])) {
        $map[(string) $drop['content_id']] = (string) $decoded['campaign_id'];
      }
    }
  }

  // The legacy 68-record 17-day manifest is not shaped like posting-
  // schedule.json (it uses "records", not "drops"), and every record
  // already carries its own campaign string — that is the source of truth
  // for the rows this table actually holds today, so it wins over any
  // posting-schedule.json that happened to reuse the same content_id.
  $legacy = $campaignsRoot . '/55-cents-17-day/manifest.json';
  if (is_file($legacy)) {
    $decoded = json_decode((string) file_get_contents($legacy), TRUE);
    foreach ($decoded['records'] ?? [] as $record) {
      if (!empty($record['content_id']) && !empty($record['campaign'])) {
        $map[(string) $record['content_id']] = (string) $record['campaign'];
      }
    }
  }

  return $map;
}

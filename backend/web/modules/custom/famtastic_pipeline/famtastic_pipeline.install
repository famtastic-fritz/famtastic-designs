    return t('Added durable microsite preorder and external-payment confirmation records.');
  }
  return t('Preserved the existing microsite preorder records.');
}

/** Seeds truthful, owner-editable content without inventing products or dates. */
function _famtastic_pipeline_seed_microsite_defaults(): void {
  $database = \Drupal::database();
  if (!$database->schema()->tableExists('famtastic_microsite')) {
    return;
  }
  $siteKey = 'thirst-trap-772';
  $existing = $database->select('famtastic_microsite', 'site')
    ->fields('site', ['id'])
    ->condition('site_key', $siteKey)
    ->execute()
    ->fetchField();
  if ($existing !== FALSE) {
    return;
  }
  $now = \Drupal::time()->getRequestTime();
  $content = [
    'schema_version' => 1,
    'site_key' => $siteKey,
    'brand' => [
      'name' => 'Thirst Trap 772',
      'tagline' => 'Crave. Drink. Repeat.',
      'service_area' => 'Vero Beach and the Treasure Coast',
      'intro' => 'Cold color, frozen flavor, and a hot-pink pop-up made for the moment.',
    ],
    'products' => [
      ['id' => 'lemonade-energy', 'name' => 'Lemonade Energy', 'kicker' => 'Cold + bright', 'description' => 'Citrus-forward refreshers from the rotating pop-up lineup.', 'price_label' => '', 'status' => 'active', 'visual' => 'citrus'],
      ['id' => 'icy-favorites', 'name' => 'Icy Favorites', 'kicker' => 'Frozen + bold', 'description' => 'Color-packed frozen drinks served ready to carry through the event.', 'price_label' => '', 'status' => 'active', 'visual' => 'berry'],
      ['id' => 'pop-up-extras', 'name' => 'Pop-Up Extras', 'kicker' => 'Sweet + social', 'description' => 'Tropical fruit, desserts, snacks, and rotating table surprises.', 'price_label' => '', 'status' => 'active', 'visual' => 'tropical'],
    ],
    'events' => [],
    'payments' => [
      'preorders_enabled' => FALSE,
      'cash_app_url' => '',
      'cash_app_label' => '',
      'payment_note' => 'Include the order reference in the payment note. Payment is confirmed manually by Thirst Trap 772.',
      'pickup_note' => 'Pickup details are confirmed directly after the preorder request is reviewed.',
    ],
    'socials' => [
      'instagram' => 'https://www.instagram.com/thirst_trap772/',
      'facebook' => 'https://www.facebook.com/ThirstTrap772/',
    ],
  ];
  $database->insert('famtastic_microsite')->fields([
    'site_key' => $siteKey,
    'owner_uid' => NULL,
    'content_json' => json_encode($content, JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE | JSON_THROW_ON_ERROR),
    'status' => 'active',
    'created' => $now,
    'changed' => $now,
  ])->execute();
}

/**
 * Adds a campaign_id column to famtastic_social_record and repoints its
 * unique key at the compound (campaign_id, content_id) identity.
 *
 * content_id (e.g. "drop-01") is a slug scaffolded fresh by every campaign's
 * posting-schedule.json — it is unique only WITHIN a campaign, never across
 * campaigns. Before this update the table's only unique key was content_id
 * alone, so a bare content_id lookup or write (an --edit-drop/--delete-drop
 * style operation, or AttributionService::recordSocialLead()) could silently
 * read or overwrite a different campaign's record whose content_id happened
 * to collide (e.g. two campaigns both scaffolding "drop-01"). Existing rows
 * are backfilled by cross-referencing every marketing/campaigns/*\/posting-
 * schedule.json's drops[].content_id and the legacy 55-cents-17-day
 * manifest's records[].content_id + records[].campaign against the
 * content_id already stored here. A content_id that cannot be matched to any
 * manifest is left with an empty campaign_id and reported by name rather
 * than guessed, and the unique key is only repointed once every row is
 * matched unambiguously.
 */
function famtastic_pipeline_update_8048(&$sandbox) {
  $schema = \Drupal::database()->schema();
  $database = \Drupal::database();

  if (!$schema->tableExists('famtastic_social_record')) {
    return t('Social record table does not exist; nothing to migrate.');
  }

  if (!$schema->fieldExists('famtastic_social_record', 'campaign_id')) {
    $schema->addField(
      'famtastic_social_record',
      'campaign_id',
      _famtastic_pipeline_lifecycle_schema()['famtastic_social_record']['fields']['campaign_id'],
    );
  }

  $map = _famtastic_pipeline_social_record_campaign_map();

  $unmatched = [];
  $rows = $database->select('famtastic_social_record', 'r')
    ->fields('r', ['id', 'content_id', 'campaign_id'])
    ->execute();
  foreach ($rows as $row) {
    if ($row->campaign_id !== '') {
      // Already backfilled by a prior partial run of this update.
      continue;
    }
    $campaignId = $map[$row->content_id] ?? NULL;
    if ($campaignId === NULL) {
      $unmatched[] = $row->content_id;
      continue;
    }
    $database->update('famtastic_social_record')
      ->fields(['campaign_id' => $campaignId])
      ->condition('id', $row->id)
      ->execute();
  }

  // Only repoint the unique key once every row resolved to a campaign; an
  // unmatched row is left with campaign_id = '' and the old bare content_id
  // key stays authoritative for the whole table until an operator resolves
  // it by hand (bare content_id collisions across campaigns cannot happen
  // yet if this table is not fully backfilled, so keeping the old key is
  // strictly safer than dropping it early).
  if (!$unmatched && $schema->indexExists('famtastic_social_record', 'content_id')) {
    $schema->dropUniqueKey('famtastic_social_record', 'content_id');
  }
  if (!$unmatched && !$schema->indexExists('famtastic_social_record', 'campaign_content')) {
    $schema->addUniqueKey('famtastic_social_record', 'campaign_content', ['campaign_id', 'content_id']);
  }
  if (!$schema->indexExists('famtastic_social_record', 'campaign')) {
    $schema->addIndex(
      'famtastic_social_record',
      'campaign',
      ['campaign_id'],
      _famtastic_pipeline_lifecycle_schema()['famtastic_social_record'],
    );
  }

  if ($unmatched) {
    return t('Added campaign_id to the social record table and backfilled every row that matched a manifest. @count row(s) could not be matched to any campaign manifest and were left with an empty campaign_id — the old content_id unique key was kept until these are resolved by hand: @ids', [
      '@count' => count($unmatched),
      '@ids' => implode(', ', array_unique($unmatched)),
    ]);
  }
  return t('Added campaign_id to the social record table, backfilled every row from its source manifest, and repointed the unique key at (campaign_id, content_id).');
}

/** Records the versioned visual template selected for each new outbox notice. */
function famtastic_pipeline_update_8049(&$sandbox) {
  $schema = \Drupal::database()->schema();
  if (!$schema->tableExists('famtastic_notification_outbox')) {
    return t('Notification outbox is not installed; no template metadata to add.');
  }
  $fields = _famtastic_pipeline_lifecycle_schema()['famtastic_notification_outbox']['fields'];
  foreach (['template_id', 'template_version'] as $field) {
    if (!$schema->fieldExists('famtastic_notification_outbox', $field)) {
      $schema->addField('famtastic_notification_outbox', $field, $fields[$field]);
    }
  }
  return t('Added immutable template identity and version fields to the notification outbox. Existing notices remain honestly marked legacy_unclassified v0.');
}


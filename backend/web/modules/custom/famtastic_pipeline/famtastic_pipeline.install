      'deals_promotions' => ['type' => 'int', 'size' => 'tiny', 'not null' => TRUE, 'default' => 1],
      'topic_keys' => ['type' => 'text', 'size' => 'normal', 'not null' => FALSE],
      'consent_version' => ['type' => 'varchar', 'length' => 32, 'not null' => TRUE, 'default' => 'portal-v1'],

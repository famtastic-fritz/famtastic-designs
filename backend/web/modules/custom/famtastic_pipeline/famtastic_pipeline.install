<?php

/**
 * @file
 * Install, update and uninstall hooks for the FAMtastic Pipeline module.
 */

/**
 * Install the ProofCampaign and ProofVariant entity types on existing sites.
 *
 * On fresh installs the entity listener creates the tables automatically;
 * sites that already had famtastic_pipeline enabled (e.g. production) need
 * this update to create the proof_campaign and proof_variant base tables.
 */
function famtastic_pipeline_update_8001(&$sandbox) {
  $manager = \Drupal::entityDefinitionUpdateManager();
  $etm = \Drupal::entityTypeManager();

  foreach (['proof_campaign', 'proof_variant'] as $entity_type_id) {
    if ($manager->getEntityType($entity_type_id) === NULL) {
      $entity_type = $etm->getDefinition($entity_type_id);
      $manager->installEntityType($entity_type);
    }
  }

  return t('Installed proof_campaign and proof_variant entity tables.');
}

/**
 * Implements hook_schema().
 */
function famtastic_pipeline_schema(): array {
  return _famtastic_pipeline_automation_schema() + [
    'famtastic_booking_request' => _famtastic_pipeline_booking_request_schema(),
    'famtastic_booking_availability' => _famtastic_pipeline_booking_availability_schema(),
  ];
}

/**
 * Implements hook_install().
 */
function famtastic_pipeline_install(): void {
  _famtastic_pipeline_seed_commercial_versions();
  _famtastic_pipeline_seed_customer_terms_v4();
  _famtastic_pipeline_seed_microsite_defaults();
}

/**
 * Adds the durable automation ledger to existing installations.
 */
function famtastic_pipeline_update_8002(&$sandbox) {
  $schema = \Drupal::database()->schema();
  $created = [];
  foreach (_famtastic_pipeline_automation_schema() as $table => $definition) {
    if (!$schema->tableExists($table)) {
      $schema->createTable($table, $definition);
      $created[] = $table;
    }
  }
  return t('Created automation ledger tables: @tables.', [
    '@tables' => $created ? implode(', ', $created) : 'none (already present)',
  ]);
}

/**
 * Seeds the immutable launch offers and test terms version.
 */
function famtastic_pipeline_update_8003(&$sandbox) {
  _famtastic_pipeline_seed_commercial_versions();
  return t('Seeded Essential Launch, Business Launch, and website service terms v1.');
}

/**
 * Adds immutable offer/terms and revision/release facts to transactions.
 */
function famtastic_pipeline_update_8004(&$sandbox) {
  $manager = \Drupal::entityDefinitionUpdateManager();
  $entityTypeManager = \Drupal::entityTypeManager();
  $fieldSets = [
    'famtastic_order' => [
      'offer_version_id',
      'terms_version_id',
      'terms_acceptance_id',
      'terms_accepted_at',
    ],
    'famtastic_project' => [
      'revision_count',
      'revision_limit',
      'release_sha',
      'artifact_checksum',
    ],
  ];
  foreach ($fieldSets as $entityTypeId => $fieldNames) {
    $entityType = $entityTypeManager->getDefinition($entityTypeId);
    $class = $entityType->getClass();
    $definitions = $class::baseFieldDefinitions($entityType);
    foreach ($fieldNames as $fieldName) {
      if (!$manager->getFieldStorageDefinition($fieldName, $entityTypeId)) {
        $manager->installFieldStorageDefinition(
          $fieldName,
          $entityTypeId,
          'famtastic_pipeline',
          $definitions[$fieldName],
        );
      }
    }
  }
  return t('Added immutable commercial, revision, and release fields.');
}


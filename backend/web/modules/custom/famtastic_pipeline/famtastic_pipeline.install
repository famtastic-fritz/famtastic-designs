/** Persists UTM attribution snapshots at lead capture (R4 / Track fix). */
function famtastic_pipeline_update_8037(&$sandbox) {
  $manager = \Drupal::entityDefinitionUpdateManager();
  if (!$manager->getFieldStorageDefinition('utm_json', 'famtastic_prospect')) {
    $entityType = \Drupal::entityTypeManager()->getDefinition('famtastic_prospect');
    $definitions = $entityType->getClass()::baseFieldDefinitions($entityType);
    $manager->installFieldStorageDefinition('utm_json', 'famtastic_prospect', 'famtastic_pipeline', $definitions['utm_json']);
  }
  $schema = \Drupal::database()->schema();
  if ($schema->tableExists('famtastic_social_record') && !$schema->fieldExists('famtastic_social_record', 'leads_count')) {
    $schema->addField(
      'famtastic_social_record',
      'leads_count',
      _famtastic_pipeline_lifecycle_schema()['famtastic_social_record']['fields']['leads_count'],
    );
  }
  return t('Added prospect attribution snapshots and social record lead counters.');
}

/** Publish-executor state columns for social records (SOCIAL_POSTING steps 4-5). */
function famtastic_pipeline_update_8038(&$sandbox) {
  $schema = \Drupal::database()->schema();
  $fields = _famtastic_pipeline_lifecycle_schema()['famtastic_social_record']['fields'];
  foreach (['postiz_scheduled_id', 'provider_state', 'published_at'] as $column) {
    if ($schema->tableExists('famtastic_social_record') && !$schema->fieldExists('famtastic_social_record', $column)) {
      $schema->addField('famtastic_social_record', $column, $fields[$column]);
    }
  }
  if ($schema->tableExists('famtastic_social_record') && !$schema->indexExists('famtastic_social_record', 'publish_state')) {
    $schema->addIndex('famtastic_social_record', 'publish_state', ['provider_state', 'approval_publish'], _famtastic_pipeline_lifecycle_schema()['famtastic_social_record']);
  }
  return t('Added publish-executor state columns to the social record table.');
}


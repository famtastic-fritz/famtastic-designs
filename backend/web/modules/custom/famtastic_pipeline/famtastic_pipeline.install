/** Repairs the Commerce order-item bundle required by product variations. */
function famtastic_pipeline_update_8020(&$sandbox) {
  if (!\Drupal::moduleHandler()->moduleExists('commerce_order')) {
    return t('Commerce Order is not enabled; no order-item bundle repair was required.');
  }
  if (!\Drupal\commerce_order\Entity\OrderItemType::load('default')) {
    \Drupal\commerce_order\Entity\OrderItemType::create([
      'id' => 'default',
      'label' => 'Default',
      'purchasableEntityType' => 'commerce_product_variation',
      'orderType' => 'default',
    ])->save();
  }
  return t('Verified the default Commerce order-item bundle used by the FAMtastic catalog.');
}

/** Allows verified portal accounts to use Commerce checkout and receipts. */
function famtastic_pipeline_update_8021(&$sandbox) {
  $role = \Drupal\user\Entity\Role::load(\Drupal\user\RoleInterface::AUTHENTICATED_ID);
  if (!$role) {
    throw new \RuntimeException('Authenticated role is unavailable.');
  }
  foreach (['access checkout', 'view own commerce_order'] as $permission) {
    if (!$role->hasPermission($permission)) {
      $role->grantPermission($permission);
    }
  }
  $role->save();
  return t('Granted portal customers checkout and own-order access.');
}

/** Repairs the default multistep Commerce checkout flow. */
function famtastic_pipeline_update_8022(&$sandbox) {
  if (!\Drupal::moduleHandler()->moduleExists('commerce_checkout')) {
    return t('Commerce Checkout is not enabled; no checkout flow repair was required.');
  }
  if (!\Drupal\commerce_checkout\Entity\CheckoutFlow::load('default')) {
    \Drupal\commerce_checkout\Entity\CheckoutFlow::create([
      'id' => 'default',
      'label' => 'FAMtastic customer checkout',
      'plugin' => 'multistep_default',
    ])->save();
  }
  return t('Verified the default multistep Commerce checkout flow.');
}

/** Repairs the Commerce Payment remote-customer field on portal accounts. */
function famtastic_pipeline_update_8023(&$sandbox) {
  if (!\Drupal::moduleHandler()->moduleExists('commerce_payment')) {
    return t('Commerce Payment is not enabled; no remote-customer field repair was required.');
  }
  if (!\Drupal\field\Entity\FieldStorageConfig::loadByName('user', 'commerce_remote_id')) {
    \Drupal\field\Entity\FieldStorageConfig::create([
      'field_name' => 'commerce_remote_id',
      'entity_type' => 'user',
      'type' => 'commerce_remote_id',
      'cardinality' => -1,
      'locked' => TRUE,
    ])->save();
  }
  if (!\Drupal\field\Entity\FieldConfig::loadByName('user', 'user', 'commerce_remote_id')) {
    \Drupal\field\Entity\FieldConfig::create([
      'field_name' => 'commerce_remote_id',
      'entity_type' => 'user',
      'bundle' => 'user',
      'label' => 'Remote ID',
    ])->save();
  }
  return t('Verified the Commerce Payment remote-customer field on portal accounts.');
}


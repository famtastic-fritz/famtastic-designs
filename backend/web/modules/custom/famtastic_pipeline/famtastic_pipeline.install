      'release_sha' => ['type' => 'varchar', 'length' => 64, 'not null' => TRUE],
      'artifact_checksum' => ['type' => 'varchar', 'length' => 64, 'not null' => TRUE],
      'status' => $short,
      'target_path' => ['type' => 'varchar', 'length' => 1024, 'not null' => TRUE],
      'public_url' => ['type' => 'varchar', 'length' => 1024, 'not null' => TRUE, 'default' => ''],
      'backup_path' => ['type' => 'varchar', 'length' => 1024, 'not null' => TRUE, 'default' => ''],
      'verification' => $long,
      'deployed_at' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => FALSE],
      'rolled_back_at' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => FALSE],
      'created' => $time,
    ],
    'primary key' => ['id'],
    'unique keys' => ['deployment_key' => ['deployment_key']],
    'indexes' => ['project_status' => ['project_id', 'status']],
  ];

  $tables['famtastic_domain'] = [
    'description' => 'Customer-owned domain and delegated DNS/SSL lifecycle.',
    'fields' => [
      'id' => $id,
      'project_id' => $entityId,
      'domain_name' => ['type' => 'varchar', 'length' => 253, 'not null' => TRUE],
      'owner_type' => $short,
      'owner_name' => ['type' => 'varchar', 'length' => 255, 'not null' => TRUE],
      'registrar' => $short,
      'management_mode' => $short,
      'authorization_evidence' => $long,
      'dns_status' => $short,
      'ssl_status' => $short,
      'expires_at' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => FALSE],
      'last_verified_at' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => FALSE],
      'created' => $time,
      'changed' => $time,
    ],
    'primary key' => ['id'],
    'unique keys' => ['domain_name' => ['domain_name']],
    'indexes' => ['project' => ['project_id']],
  ];

  $tables['famtastic_hosting_entitlement'] = [
    'description' => 'Included and recurring hosting service periods.',
    'fields' => [
      'id' => $id,
      'project_id' => $entityId,
      'order_id' => $entityId,
      'status' => $short,
      'starts_at' => $time,
      'included_until' => $time,
      'renews_at' => $time,
      'suspended_at' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => FALSE],
      'ended_at' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => FALSE],
      'created' => $time,
      'changed' => $time,
    ],
    'primary key' => ['id'],
    'unique keys' => ['project' => ['project_id']],
    'indexes' => ['renewals' => ['status', 'renews_at']],
  ];

  $tables['famtastic_subscription'] = [
    'description' => 'Month-13 recurring hosting subscription state.',
    'fields' => [
      'id' => $id,
      'entitlement_id' => $entityId,
      'provider' => $short,
      'provider_customer_id' => ['type' => 'varchar', 'length' => 255, 'not null' => TRUE, 'default' => ''],
      'provider_subscription_id' => ['type' => 'varchar', 'length' => 255, 'not null' => TRUE, 'default' => ''],
      'status' => $short,
      'amount_minor' => ['type' => 'int', 'not null' => TRUE],
      'currency' => ['type' => 'varchar', 'length' => 8, 'not null' => TRUE, 'default' => 'usd'],
      'retry_count' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE, 'default' => 0],
      'next_attempt_at' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => FALSE],
      'cancel_at' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => FALSE],
      'created' => $time,
      'changed' => $time,
    ],
    'primary key' => ['id'],
    'unique keys' => ['entitlement' => ['entitlement_id']],
    'indexes' => ['status_attempt' => ['status', 'next_attempt_at']],
  ];

  $tables['famtastic_exception'] = [
    'description' => 'Actionable failures requiring retry or operator handling.',
    'fields' => [
      'id' => $id,
      'exception_key' => ['type' => 'varchar', 'length' => 191, 'not null' => TRUE],
      'category' => $short,
      'severity' => $short,
      'status' => $short,
      'prospect_id' => $entityId,
      'job_id' => $entityId,
      'summary' => ['type' => 'varchar', 'length' => 512, 'not null' => TRUE],
      'details' => $long,
      'retryable' => ['type' => 'int', 'size' => 'tiny', 'not null' => TRUE, 'default' => 1],
      'retry_after' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => FALSE],
      'resolved_at' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => FALSE],
      'created' => $time,
      'changed' => $time,
    ],
    'primary key' => ['id'],
    'unique keys' => ['exception_key' => ['exception_key']],
    'indexes' => ['queue' => ['status', 'severity', 'created']],
  ];

  $tables['famtastic_lead_import'] = _famtastic_pipeline_lead_import_schema();
  $tables['famtastic_email_message'] = _famtastic_pipeline_email_message_schema();
  $tables['famtastic_build_run'] = _famtastic_pipeline_build_run_schema();

  foreach (_famtastic_pipeline_customer_portal_schema() as $table => $definition) {
    $tables[$table] = $definition;
  }
  foreach (_famtastic_pipeline_portal_engagement_schema() as $table => $definition) {
    $tables[$table] = $definition;
  }
  $tables['famtastic_deep_dive_invitation'] = _famtastic_pipeline_deep_dive_invitation_schema();
  foreach (_famtastic_pipeline_lifecycle_schema() as $table => $definition) {
    $tables[$table] = $definition;
  }
  foreach (_famtastic_pipeline_microsite_schema() as $table => $definition) {
    $tables[$table] = $definition;
  }

  return $tables;
}

/**
 * Durable, owner-linked content and inbound capture for small client sites.
 */
function _famtastic_pipeline_microsite_schema(): array {
  return [
    'famtastic_microsite' => [
      'description' => 'Small-business microsite content and ownership binding.',
      'fields' => [
        'id' => ['type' => 'serial', 'not null' => TRUE],
        'site_key' => ['type' => 'varchar', 'length' => 64, 'not null' => TRUE],
        'owner_uid' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => FALSE],
        'content_json' => ['type' => 'text', 'size' => 'big', 'not null' => TRUE],
        'status' => ['type' => 'varchar', 'length' => 24, 'not null' => TRUE, 'default' => 'active'],
        'created' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
        'changed' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
      ],
      'primary key' => ['id'],
      'unique keys' => ['site_key' => ['site_key']],
      'indexes' => ['owner_uid' => ['owner_uid'], 'status' => ['status']],
    ],
    'famtastic_microsite_message' => [
      'description' => 'Contact and consented subscriber records captured by a microsite.',
      'fields' => [
        'id' => ['type' => 'serial', 'not null' => TRUE],
        'site_key' => ['type' => 'varchar', 'length' => 64, 'not null' => TRUE],
        'kind' => ['type' => 'varchar', 'length' => 24, 'not null' => TRUE],
        'name' => ['type' => 'varchar', 'length' => 120, 'not null' => TRUE, 'default' => ''],
        'email' => ['type' => 'varchar', 'length' => 254, 'not null' => TRUE],
        'email_hash' => ['type' => 'varchar', 'length' => 64, 'not null' => TRUE],
        'phone' => ['type' => 'varchar', 'length' => 40, 'not null' => TRUE, 'default' => ''],
        'subject' => ['type' => 'varchar', 'length' => 120, 'not null' => TRUE, 'default' => ''],
        'message' => ['type' => 'text', 'size' => 'big', 'not null' => TRUE],
        'consent' => ['type' => 'int', 'size' => 'tiny', 'not null' => TRUE, 'default' => 0],
        'status' => ['type' => 'varchar', 'length' => 24, 'not null' => TRUE, 'default' => 'new'],
        'source' => ['type' => 'varchar', 'length' => 120, 'not null' => TRUE, 'default' => 'site'],
        'created' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
        'changed' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
      ],
      'primary key' => ['id'],
      'indexes' => [
        'site_kind_status' => ['site_key', 'kind', 'status'],
        'site_email' => ['site_key', 'email_hash'],
        'created' => ['created'],
      ],
    ],
    'famtastic_microsite_order' => [
      'description' => 'Durable preorder requests and owner-confirmed external payment status for a microsite.',
      'fields' => [
        'id' => ['type' => 'serial', 'not null' => TRUE],
        'public_id' => ['type' => 'varchar', 'length' => 36, 'not null' => TRUE],
        'order_number' => ['type' => 'varchar', 'length' => 24, 'not null' => TRUE],
        'site_key' => ['type' => 'varchar', 'length' => 64, 'not null' => TRUE],
        'customer_name' => ['type' => 'varchar', 'length' => 120, 'not null' => TRUE],
        'email' => ['type' => 'varchar', 'length' => 254, 'not null' => TRUE],
        'email_hash' => ['type' => 'varchar', 'length' => 64, 'not null' => TRUE],
        'phone' => ['type' => 'varchar', 'length' => 40, 'not null' => TRUE, 'default' => ''],
        'items_json' => ['type' => 'text', 'size' => 'big', 'not null' => TRUE],
        'item_count' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE, 'default' => 0],
        'total_cents' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => FALSE],
        'currency' => ['type' => 'varchar', 'length' => 3, 'not null' => TRUE, 'default' => 'USD'],
        'pickup_event_id' => ['type' => 'varchar', 'length' => 64, 'not null' => TRUE, 'default' => ''],
        'pickup_label' => ['type' => 'varchar', 'length' => 160, 'not null' => TRUE, 'default' => ''],
        'notes' => ['type' => 'text', 'size' => 'normal', 'not null' => TRUE],
        'payment_method' => ['type' => 'varchar', 'length' => 32, 'not null' => TRUE, 'default' => 'coordinate'],
        'payment_destination' => ['type' => 'varchar', 'length' => 500, 'not null' => TRUE, 'default' => ''],
        'payment_status' => ['type' => 'varchar', 'length' => 24, 'not null' => TRUE, 'default' => 'unverified'],
        'order_status' => ['type' => 'varchar', 'length' => 24, 'not null' => TRUE, 'default' => 'requested'],
        'source' => ['type' => 'varchar', 'length' => 120, 'not null' => TRUE, 'default' => 'site'],
        'created' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
        'changed' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
      ],
      'primary key' => ['id'],
      'unique keys' => ['public_id' => ['public_id'], 'order_number' => ['order_number']],
      'indexes' => [
        'site_status' => ['site_key', 'order_status', 'created'],
        'site_email' => ['site_key', 'email_hash'],
        'created' => ['created'],
      ],
    ],
  ];
}

/** Schema for an owner-gated public concept-room delivery. */
function _famtastic_pipeline_preview_delivery_schema(): array {
  $id = ['type' => 'serial', 'unsigned' => TRUE, 'not null' => TRUE];
  $time = ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE, 'default' => 0];
  $nullableTime = ['type' => 'int', 'unsigned' => TRUE, 'not null' => FALSE];
  $entity = ['type' => 'int', 'unsigned' => TRUE, 'not null' => FALSE];
  return [
    'famtastic_preview_delivery' => [
      'description' => 'Owner-gated public lead preview delivery, revocable concept room, and verified account claim.',
      'fields' => [
        'id' => $id,
        'public_id' => ['type' => 'varchar', 'length' => 36, 'not null' => TRUE],
        'delivery_key' => ['type' => 'varchar', 'length' => 191, 'not null' => TRUE],
        'prospect_id' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
        'intake_id' => $entity,
        'proof_campaign_id' => $entity,
        // Frozen per-delivery proof profile: never resolve a later global
        // configuration revision after this public lead has been created.
        'package_profile' => ['type' => 'varchar', 'length' => 128, 'not null' => TRUE, 'default' => ''],
        'package_variant_count' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE, 'default' => 3],
        'proof_profile_snapshot' => ['type' => 'text', 'size' => 'normal', 'not null' => FALSE],
        'proof_profile_hash' => ['type' => 'varchar', 'length' => 64, 'not null' => TRUE, 'default' => ''],
        // `verified_cold` is a strict media-gate marker, not a marketing label.
        'source_lane' => ['type' => 'varchar', 'length' => 32, 'not null' => TRUE, 'default' => 'anonymous_public'],
        'scheduled_release_at' => $nullableTime,
        'scheduled_release_set_at' => $nullableTime,
        // A staged room serves this exact direction/path/hash set, not whatever
        // mutable proof_variant rows happen to contain later.
        'proof_variant_snapshot' => ['type' => 'text', 'size' => 'big', 'not null' => FALSE],
        'build_dna_id' => ['type' => 'varchar', 'length' => 170, 'not null' => TRUE, 'default' => ''],
        'build_dna_hash' => ['type' => 'varchar', 'length' => 64, 'not null' => TRUE, 'default' => ''],
        'state' => ['type' => 'varchar', 'length' => 48, 'not null' => TRUE, 'default' => 'lead_captured'],
        'recipient_hash' => ['type' => 'varchar', 'length' => 64, 'not null' => TRUE, 'default' => ''],
        'recipient_address_snapshot' => ['type' => 'varchar', 'length' => 320, 'not null' => TRUE, 'default' => ''],
        'template_key' => ['type' => 'varchar', 'length' => 96, 'not null' => TRUE, 'default' => 'lead_preview_ready'],
        'template_version' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE, 'default' => 1],
        'subject_snapshot' => ['type' => 'varchar', 'length' => 512, 'not null' => TRUE, 'default' => ''],
        'text_snapshot' => ['type' => 'text', 'size' => 'big', 'not null' => TRUE],
        'public_context_snapshot' => ['type' => 'text', 'size' => 'normal', 'not null' => FALSE],
        'research_teaser_snapshot' => ['type' => 'text', 'size' => 'normal', 'not null' => FALSE],
        'research_sources_snapshot' => ['type' => 'text', 'size' => 'big', 'not null' => FALSE],
        'research_report_snapshot' => ['type' => 'text', 'size' => 'big', 'not null' => FALSE],
        'research_snapshot_hash' => ['type' => 'varchar', 'length' => 64, 'not null' => TRUE, 'default' => ''],
        'research_evidence_hash' => ['type' => 'varchar', 'length' => 64, 'not null' => TRUE, 'default' => ''],
        'research_evidence_role' => ['type' => 'varchar', 'length' => 128, 'not null' => TRUE, 'default' => ''],
        'share_token_hash' => ['type' => 'varchar', 'length' => 64, 'not null' => TRUE, 'default' => ''],
        'share_version' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE, 'default' => 1],
        'share_expires_at' => $nullableTime,
        'share_revoked_at' => $nullableTime,
        'share_revoked_by_uid' => $entity,
        'owner_approved_at' => $nullableTime,
        'owner_approved_by_uid' => $entity,
        'email_outbox_id' => $entity,
        'commercial_message_id' => $entity,
        'dispatch_key' => ['type' => 'varchar', 'length' => 191, 'not null' => TRUE, 'default' => ''],
        'dispatch_claimed_at' => $nullableTime,
        'dispatch_completed_at' => $nullableTime,
        'dispatch_failed_at' => $nullableTime,
        'provider_message_id' => ['type' => 'varchar', 'length' => 255, 'not null' => TRUE, 'default' => ''],
        'signup_started_at' => $nullableTime,
        'customer_id' => $entity,
        'claimed_at' => $nullableTime,
        'website_request_id' => $entity,
        'requested_at' => $time,
        'proof_ready_at' => $nullableTime,
        'queued_at' => $nullableTime,
        'accepted_at' => $nullableTime,
        'last_event_at' => $time,
        'expires_at' => $nullableTime,
        'created' => $time,
        'changed' => $time,
      ],
      'primary key' => ['id'],
      'unique keys' => [
        'public_id' => ['public_id'],
        'delivery_key' => ['delivery_key'],
      ],
      'indexes' => [
        'prospect_state' => ['prospect_id', 'state'],
        'customer_state' => ['customer_id', 'state'],
        'proof_campaign' => ['proof_campaign_id'],
        'outbox' => ['email_outbox_id'],
        'commercial_message' => ['commercial_message_id'],
        'dispatch' => ['dispatch_key'],
        'scheduled_release' => ['state', 'scheduled_release_at'],
        'share_expiry' => ['state', 'share_expires_at'],
      ],
    ],
  ];
}

/** Source/audit records for cold cohorts that enter the public proof lane. */
function _famtastic_pipeline_cold_proof_schema(): array {
  $id = ['type' => 'serial', 'unsigned' => TRUE, 'not null' => TRUE];
  $entity = ['type' => 'int', 'unsigned' => TRUE, 'not null' => FALSE];
  $time = ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE, 'default' => 0];
  $nullableTime = ['type' => 'int', 'unsigned' => TRUE, 'not null' => FALSE];
  return [
    'famtastic_cold_proof_cohort' => [
      'description' => 'Immutable verified-source cold proof cohort contract; never a mail queue.',
      'fields' => [
        'id' => $id,
        'cohort_key' => ['type' => 'varchar', 'length' => 128, 'not null' => TRUE],
        'campaign_id' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
        'campaign_key' => ['type' => 'varchar', 'length' => 128, 'not null' => TRUE],
        'source_name' => ['type' => 'varchar', 'length' => 255, 'not null' => TRUE],
        'source_lane' => ['type' => 'varchar', 'length' => 32, 'not null' => TRUE, 'default' => 'verified_cold'],
        'package_profile' => ['type' => 'varchar', 'length' => 128, 'not null' => TRUE],
        'direction_count' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
        'direction_contract' => ['type' => 'text', 'size' => 'normal', 'not null' => TRUE],
        'profile_snapshot_hash' => ['type' => 'varchar', 'length' => 64, 'not null' => TRUE],
        'scheduled_release_at' => $nullableTime,
        'status' => ['type' => 'varchar', 'length' => 32, 'not null' => TRUE, 'default' => 'seeded'],
        'created' => $time,
        'changed' => $time,
      ],
      'primary key' => ['id'],
      'unique keys' => ['cohort_key' => ['cohort_key']],
      'indexes' => ['campaign' => ['campaign_id'], 'scheduled_release' => ['scheduled_release_at', 'status']],
    ],
    'famtastic_cold_proof_ingress' => [
      'description' => 'Per-lead verified public source and explicit public-preview job linkage.',
      'fields' => [
        'id' => $id,
        'ingress_key' => ['type' => 'varchar', 'length' => 64, 'not null' => TRUE],
        'cohort_id' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
        'prospect_id' => $entity,
        'intake_id' => $entity,
        'preview_delivery_id' => $entity,
        'proof_campaign_id' => $entity,
        'proof_job_id' => $entity,
        'source_record_id' => ['type' => 'varchar', 'length' => 255, 'not null' => TRUE],
        'source_lane' => ['type' => 'varchar', 'length' => 32, 'not null' => TRUE, 'default' => 'verified_cold'],
        'source_url' => ['type' => 'varchar', 'length' => 2048, 'not null' => TRUE],
        'source_provenance' => ['type' => 'varchar', 'length' => 255, 'not null' => TRUE],
        'source_timeframe' => ['type' => 'varchar', 'length' => 128, 'not null' => TRUE],
        'website_observation_status' => ['type' => 'varchar', 'length' => 32, 'not null' => TRUE],
        'website_observation_fact' => ['type' => 'text', 'size' => 'normal', 'not null' => TRUE],
        'corroborated_fact' => ['type' => 'text', 'size' => 'normal', 'not null' => TRUE],
        'proof_teaser' => ['type' => 'text', 'size' => 'normal', 'not null' => TRUE],
        'evidence_hash' => ['type' => 'varchar', 'length' => 64, 'not null' => TRUE],
        'scheduled_release_at' => $nullableTime,
        'status' => ['type' => 'varchar', 'length' => 32, 'not null' => TRUE, 'default' => 'seeded'],
        'created' => $time,
        'changed' => $time,
      ],
      'primary key' => ['id'],
      'unique keys' => ['ingress_key' => ['ingress_key']],
      'indexes' => [
        'cohort_record' => ['cohort_id', 'source_record_id'],
        'delivery' => ['preview_delivery_id'],
        'proof_campaign' => ['proof_campaign_id'],
        'scheduled_release' => ['scheduled_release_at', 'status'],
      ],
    ],
  ];
}

/**
 * Defines records shared by Commerce fulfillment and customer operations.
 */
function _famtastic_pipeline_lifecycle_schema(): array {
  $id = ['type' => 'serial', 'unsigned' => TRUE, 'not null' => TRUE];
  $entity = ['type' => 'int', 'unsigned' => TRUE, 'not null' => FALSE];
  $time = ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE, 'default' => 0];
  $short = ['type' => 'varchar', 'length' => 64, 'not null' => TRUE, 'default' => ''];
  $tables['famtastic_commerce_fulfillment'] = [
    'description' => 'Idempotent bridge from Commerce orders to customer lifecycle records.',
    'fields' => [
      'id' => $id, 'commerce_order_id' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
      'organization_id' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
      'customer_id' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
      'prospect_id' => $entity, 'intake_id' => $entity, 'project_id' => $entity,
      'status' => $short, 'sku_snapshot' => ['type' => 'text', 'size' => 'normal', 'not null' => TRUE],
      'amount_minor' => ['type' => 'int', 'not null' => TRUE], 'currency' => ['type' => 'varchar', 'length' => 8, 'not null' => TRUE],
      'fulfilled_at' => $time, 'created' => $time, 'changed' => $time,
    ],
    'primary key' => ['id'], 'unique keys' => ['commerce_order' => ['commerce_order_id']],
    'indexes' => ['organization' => ['organization_id', 'created']],
  ];
  $tables['famtastic_notification_outbox'] = [
    'description' => 'Idempotent transactional and promotional notification outbox.',
    'fields' => [
      'id' => $id, 'notification_key' => ['type' => 'varchar', 'length' => 191, 'not null' => TRUE],
      'category' => $short, 'recipient' => ['type' => 'varchar', 'length' => 320, 'not null' => TRUE],
      'subject' => ['type' => 'varchar', 'length' => 512, 'not null' => TRUE],
      'body' => ['type' => 'text', 'size' => 'big', 'not null' => TRUE],
      'template_id' => ['type' => 'varchar', 'length' => 128, 'not null' => TRUE, 'default' => 'legacy_unclassified'],
      'template_version' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE, 'default' => 0],
      'status' => $short,
      'attempts' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE, 'default' => 0],
      'max_attempts' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE, 'default' => 5],
      'available_at' => $time, 'sent_at' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => FALSE],
      'provider_message_id' => ['type' => 'varchar', 'length' => 255, 'not null' => TRUE, 'default' => ''],
      'last_error' => ['type' => 'text', 'size' => 'normal', 'not null' => FALSE], 'created' => $time, 'changed' => $time,
    ],
    'primary key' => ['id'], 'unique keys' => ['notification_key' => ['notification_key']],
    'indexes' => ['queue' => ['status', 'available_at'], 'recipient' => ['recipient', 'created']],
  ];
  $tables += _famtastic_pipeline_preview_delivery_schema();
  $tables += _famtastic_pipeline_cold_proof_schema();
  $tables['famtastic_support_case'] = [
    'description' => 'Operational support case workflow linked to a portal thread.',
    'fields' => [
      'id' => $id, 'case_number' => ['type' => 'varchar', 'length' => 24, 'not null' => TRUE],
      'thread_id' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE], 'category' => $short,
      'priority' => $short, 'status' => $short, 'owner_uid' => $entity, 'service_key' => $short,
      'response_due' => $time, 'responded_at' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => FALSE],
      'resolved_at' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => FALSE],
      'satisfaction' => ['type' => 'int', 'size' => 'tiny', 'unsigned' => TRUE, 'not null' => FALSE],
      'created' => $time, 'changed' => $time,
    ],
    'primary key' => ['id'], 'unique keys' => ['case_number' => ['case_number'], 'thread' => ['thread_id']],
    'indexes' => ['queue' => ['status', 'response_due'], 'owner' => ['owner_uid', 'status']],
  ];
  $tables['famtastic_inbound_message'] = [
    'description' => 'Validated inbound mailbox messages and matching results.',
    'fields' => [
      'id' => $id, 'message_id_hash' => ['type' => 'varchar', 'length' => 64, 'not null' => TRUE],
      'thread_public_id' => ['type' => 'varchar', 'length' => 36, 'not null' => TRUE, 'default' => ''],
      'sender_hash' => ['type' => 'varchar', 'length' => 64, 'not null' => TRUE], 'subject' => ['type' => 'varchar', 'length' => 512, 'not null' => TRUE],
      'body' => ['type' => 'text', 'size' => 'big', 'not null' => TRUE], 'attachment_manifest' => ['type' => 'text', 'size' => 'big', 'not null' => FALSE],
      'status' => $short, 'rejection_reason' => $short, 'received_at' => $time, 'created' => $time,
    ],
    'primary key' => ['id'], 'unique keys' => ['message_id' => ['message_id_hash']],
    'indexes' => ['thread' => ['thread_public_id', 'received_at'], 'status' => ['status', 'received_at']],
  ];
  $tables['famtastic_social_record'] = [
    'description' => 'Per-record state for the 17-day social campaign: gates, assets, provider ids.',
    'fields' => [
      'id' => ['type' => 'serial', 'unsigned' => TRUE, 'not null' => TRUE],
      // content_id (e.g. "drop-01") is a slug that is only unique WITHIN a
      // campaign, never across campaigns — every campaign's posting-schedule
      // scaffolds drops named drop-01, drop-02, etc. The durable identity of
      // a drop is the compound key "{campaign_id}/{content_id}", so every
      // lookup, insert, and unique constraint on this table is keyed on
      // (campaign_id, content_id) together. Never match on content_id alone.
      'campaign_id' => ['type' => 'varchar', 'length' => 191, 'not null' => TRUE, 'default' => ''],
      'content_id' => ['type' => 'varchar', 'length' => 64, 'not null' => TRUE],
      'day' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE, 'default' => 0],
      'moment' => ['type' => 'varchar', 'length' => 32, 'not null' => TRUE, 'default' => ''],
      'theme' => ['type' => 'varchar', 'length' => 64, 'not null' => TRUE, 'default' => ''],
      'promise' => ['type' => 'varchar', 'length' => 255, 'not null' => TRUE, 'default' => ''],
      'scheduled_time_et' => ['type' => 'varchar', 'length' => 8, 'not null' => TRUE, 'default' => ''],
      'state' => ['type' => 'varchar', 'length' => 32, 'not null' => TRUE, 'default' => 'idea'],
      'approval_content' => ['type' => 'int', 'size' => 'tiny', 'unsigned' => TRUE, 'not null' => TRUE, 'default' => 0],
      'approval_media' => ['type' => 'int', 'size' => 'tiny', 'unsigned' => TRUE, 'not null' => TRUE, 'default' => 0],
      'approval_publish' => ['type' => 'int', 'size' => 'tiny', 'unsigned' => TRUE, 'not null' => TRUE, 'default' => 0],
      'postiz_draft_id' => ['type' => 'varchar', 'length' => 64, 'not null' => TRUE, 'default' => ''],
      'leads_count' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE, 'default' => 0],
      'postiz_scheduled_id' => ['type' => 'varchar', 'length' => 64, 'not null' => TRUE, 'default' => ''],
      'provider_state' => ['type' => 'varchar', 'length' => 32, 'not null' => TRUE, 'default' => ''],
      'published_at' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE, 'default' => 0],
      'asset_variants' => ['type' => 'text', 'size' => 'normal', 'not null' => TRUE],
      'changed' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE, 'default' => 0],
    ],
    'primary key' => ['id'],
    'unique keys' => ['campaign_content' => ['campaign_id', 'content_id']],
    'indexes' => ['day' => ['day'], 'gates' => ['approval_content', 'approval_media', 'approval_publish'], 'publish_state' => ['provider_state', 'approval_publish'], 'campaign' => ['campaign_id']],
  ];
  $tables['famtastic_support_draft'] = [
    'description' => 'L0 draft replies generated per inbound message; nothing sends without owner approval.',
    'fields' => [
      'id' => $id, 'message_id' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
      'thread_public_id' => ['type' => 'varchar', 'length' => 36, 'not null' => TRUE, 'default' => ''],
      'intent' => $short, 'confidence' => ['type' => 'float', 'size' => 'normal', 'not null' => TRUE, 'default' => 0],
      'escalate' => ['type' => 'int', 'size' => 'tiny', 'unsigned' => TRUE, 'not null' => TRUE, 'default' => 0],
      'template_id' => $short, 'body' => ['type' => 'text', 'size' => 'big', 'not null' => TRUE],
      'status' => $short, 'reviewer_uid' => $entity, 'decided_at' => $time,
      'sla_target_seconds' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE, 'default' => 0],
      'created' => $time,
    ],
    'primary key' => ['id'], 'unique keys' => ['message' => ['message_id']],
    'indexes' => ['queue' => ['status', 'created'], 'thread' => ['thread_public_id']],
  ];
  $tables['famtastic_worker_heartbeat'] = [
    'description' => 'Worker health, throughput, retry, and failure telemetry.',
    'fields' => [
      'worker_key' => ['type' => 'varchar', 'length' => 128, 'not null' => TRUE], 'status' => $short,
      'last_started' => $time, 'last_finished' => $time, 'next_due' => $time,
      'processed' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE, 'default' => 0],
      'failed' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE, 'default' => 0],
      'retried' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE, 'default' => 0],
      'last_error' => ['type' => 'text', 'size' => 'normal', 'not null' => FALSE], 'changed' => $time,
    ],
    'primary key' => ['worker_key'], 'indexes' => ['due' => ['status', 'next_due']],
  ];
  return $tables;
}

/**
 * Defines customer-controlled content preferences and referral records.

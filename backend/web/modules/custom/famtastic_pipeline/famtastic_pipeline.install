<?php

/**
 * @file
 * Install, update and uninstall hooks for the FAMtastic Pipeline module.
 */

/**
 * Install the ProofCampaign and ProofVariant entity types on existing sites.
 *
 * On fresh installs the entity listener creates the tables automatically;
 * sites that already had famtastic_pipeline enabled (e.g. production) need
 * this update to create the proof_campaign and proof_variant base tables.
 */
function famtastic_pipeline_update_8001(&$sandbox) {
  $manager = \Drupal::entityDefinitionUpdateManager();
  $etm = \Drupal::entityTypeManager();

  foreach (['proof_campaign', 'proof_variant'] as $entity_type_id) {
    if ($manager->getEntityType($entity_type_id) === NULL) {
      $entity_type = $etm->getDefinition($entity_type_id);
      $manager->installEntityType($entity_type);
    }
  }

  return t('Installed proof_campaign and proof_variant entity tables.');
}

/**
 * Implements hook_schema().
 */
function famtastic_pipeline_schema(): array {
  return _famtastic_pipeline_automation_schema();
}

/**
 * Implements hook_install().
 */
function famtastic_pipeline_install(): void {
  _famtastic_pipeline_seed_commercial_versions();
}

/**
 * Adds the durable automation ledger to existing installations.
 */
function famtastic_pipeline_update_8002(&$sandbox) {
  $schema = \Drupal::database()->schema();
  $created = [];
  foreach (_famtastic_pipeline_automation_schema() as $table => $definition) {
    if (!$schema->tableExists($table)) {
      $schema->createTable($table, $definition);
      $created[] = $table;
    }
  }
  return t('Created automation ledger tables: @tables.', [
    '@tables' => $created ? implode(', ', $created) : 'none (already present)',
  ]);
}

/**
 * Seeds the immutable launch offers and test terms version.
 */
function famtastic_pipeline_update_8003(&$sandbox) {
  _famtastic_pipeline_seed_commercial_versions();
  return t('Seeded Essential Launch, Business Launch, and website service terms v1.');
}

/**
 * Adds immutable offer/terms and revision/release facts to transactions.
 */
function famtastic_pipeline_update_8004(&$sandbox) {
  $manager = \Drupal::entityDefinitionUpdateManager();
  $entityTypeManager = \Drupal::entityTypeManager();
  $fieldSets = [
    'famtastic_order' => [
      'offer_version_id',
      'terms_version_id',
      'terms_acceptance_id',
      'terms_accepted_at',
    ],
    'famtastic_project' => [
      'revision_count',
      'revision_limit',
      'release_sha',
      'artifact_checksum',
    ],
  ];
  foreach ($fieldSets as $entityTypeId => $fieldNames) {
    $entityType = $entityTypeManager->getDefinition($entityTypeId);
    $class = $entityType->getClass();
    $definitions = $class::baseFieldDefinitions($entityType);
    foreach ($fieldNames as $fieldName) {
      if (!$manager->getFieldStorageDefinition($fieldName, $entityTypeId)) {
        $manager->installFieldStorageDefinition(
          $fieldName,
          $entityTypeId,
          'famtastic_pipeline',
          $definitions[$fieldName],
        );
      }
    }
  }
  return t('Added immutable commercial, revision, and release fields.');
}

/**
 * Adds normalized lead-import provenance and deduplication.
 */
function famtastic_pipeline_update_8005(&$sandbox) {
  $schema = \Drupal::database()->schema();
  $definition = _famtastic_pipeline_lead_import_schema();
  if (!$schema->tableExists('famtastic_lead_import')) {
    $schema->createTable('famtastic_lead_import', $definition);
  }
  return t('Added lead import provenance and deduplication table.');
}

/**
 * Adds staged campaign email delivery and tracking records.
 */
function famtastic_pipeline_update_8006(&$sandbox) {
  $schema = \Drupal::database()->schema();
  if (!$schema->tableExists('famtastic_email_message')) {
    $schema->createTable('famtastic_email_message', _famtastic_pipeline_email_message_schema());
  }
  return t('Added campaign email message and provider tracking table.');
}

/**
 * Adds asynchronous Site Studio dispatch and callback state.
 */
function famtastic_pipeline_update_8007(&$sandbox) {
  $manager = \Drupal::entityDefinitionUpdateManager();
  $entityType = \Drupal::entityTypeManager()->getDefinition('proof_campaign');
  $class = $entityType->getClass();
  $definitions = $class::baseFieldDefinitions($entityType);
  foreach (['generation_status', 'studio_job_id', 'callback_event_ids', 'dispatched_at', 'ready_at'] as $fieldName) {
    if (!$manager->getFieldStorageDefinition($fieldName, 'proof_campaign')) {
      $manager->installFieldStorageDefinition($fieldName, 'proof_campaign', 'famtastic_pipeline', $definitions[$fieldName]);
    }
  }
  return t('Added asynchronous Site Studio dispatch and callback fields.');
}

/**
 * Aligns the pipeline sender with the authenticated production mailbox.
 */
function famtastic_pipeline_update_8008(&$sandbox) {
  $config = \Drupal::configFactory()->getEditable('famtastic_pipeline.settings');
  if ($config->get('support_from_email') === 'support@famtasticdesigns.com') {
    $config->set('support_from_email', 'hello@famtasticdesigns.com')->save(TRUE);
    return t('Aligned the pipeline sender with hello@famtasticdesigns.com.');
  }
  return t('Preserved the existing customized pipeline sender.');
}

/**
 * Repairs an enabled SMTP configuration whose active mail system drifted.
 */
function famtastic_pipeline_update_8009(&$sandbox) {
  if (!\Drupal::moduleHandler()->moduleExists('smtp')) {
    return t('SMTP is not installed; the active mail system was not changed.');
  }

  $smtp = \Drupal::config('smtp.settings');
  if (!$smtp->get('smtp_on')) {
    return t('SMTP is disabled; the active mail system was not changed.');
  }

  $mail = \Drupal::configFactory()->getEditable('system.mail');
  if ($mail->get('interface.default') !== 'SMTPMailSystem') {
    $mail->set('interface.default', 'SMTPMailSystem')->save(TRUE);
    return t('Selected SMTPMailSystem for the enabled SMTP transport.');
  }

  return t('SMTPMailSystem was already selected.');
}

/**
 * Adds operator-visible message snapshots and proof-build telemetry.
 */
function famtastic_pipeline_update_8010(&$sandbox) {
  $database = \Drupal::database();
  $schema = $database->schema();
  $emailFields = _famtastic_pipeline_email_message_schema()['fields'];
  foreach (['recipient_address', 'from_address', 'body_snapshot', 'proof_campaign_id', 'proof_url'] as $field) {
    if (!$schema->fieldExists('famtastic_email_message', $field)) {
      $schema->addField('famtastic_email_message', $field, $emailFields[$field]);
    }
  }
  if (!$schema->tableExists('famtastic_build_run')) {
    $schema->createTable('famtastic_build_run', _famtastic_pipeline_build_run_schema());
  }

  $prospectStorage = \Drupal::entityTypeManager()->getStorage('famtastic_prospect');
  $proofStorage = \Drupal::entityTypeManager()->getStorage('proof_campaign');
  $messages = $database->select('famtastic_email_message', 'm')
    ->fields('m', ['id', 'prospect_id'])
    ->execute()
    ->fetchAll(\PDO::FETCH_ASSOC);
  foreach ($messages as $message) {
    $prospect = $prospectStorage->load((int) $message['prospect_id']);
    $proofIds = $proofStorage->getQuery()
      ->accessCheck(FALSE)
      ->condition('prospect_id', (int) $message['prospect_id'])
      ->sort('id', 'DESC')
      ->range(0, 1)
      ->execute();
    $database->update('famtastic_email_message')
      ->fields([
        'recipient_address' => $prospect ? (string) $prospect->get('public_email')->value : '',
        'proof_campaign_id' => $proofIds ? (int) reset($proofIds) : NULL,
      ])
      ->condition('id', (int) $message['id'])
      ->execute();
  }

  /** @var \Drupal\famtastic_pipeline\Service\BuildTelemetryService $telemetry */
  $telemetry = \Drupal::service('famtastic_pipeline.build_telemetry');
  $variantStorage = \Drupal::entityTypeManager()->getStorage('proof_variant');
  $proofIds = $proofStorage->getQuery()->accessCheck(FALSE)->execute();
  foreach ($proofStorage->loadMultiple($proofIds) as $proof) {
    $prospect = $prospectStorage->load((int) $proof->get('prospect_id')->target_id);
    if (!$prospect || $proof->get('generation_status')->value !== 'ready') {
      continue;
    }
    $variantIds = $variantStorage->getQuery()
      ->accessCheck(FALSE)
      ->condition('campaign_id', (int) $proof->id())
      ->sort('direction_id')
      ->execute();
    $variants = array_values($variantStorage->loadMultiple($variantIds));
    if (count($variants) !== 3) {
      continue;
    }
    $dna = json_decode((string) $variants[0]->get('design_dna')->value, TRUE);
    if (($dna['source'] ?? '') === 'no_image_pilot_v1') {
      $telemetry->recordPilotProof($prospect, $proof, $variants);
    }
    else {
      $telemetry->recordStudioProof($prospect, $proof, $variants, [
        'provider' => $dna['provider'] ?? ($dna['source'] ?? 'historical_import'),
        'agent_name' => $dna['agent'] ?? 'unknown',
      ]);
    }
  }

  return t('Added exact email snapshots, recipient audit fields, and proof-build telemetry.');
}

/**
 * Removes storefront and required-call language from the contact source node.
 */
function famtastic_pipeline_update_8011(&$sandbox) {
  $path = \Drupal::service('path_alias.manager')->getPathByAlias('/contact');
  $contact = NULL;
  if (preg_match('#^/node/(\d+)$#', $path, $matches)) {
    $contact = \Drupal::entityTypeManager()->getStorage('node')->load((int) $matches[1]);
  }
  if (!$contact) {
    $matches = \Drupal::entityTypeManager()->getStorage('node')->loadByProperties(['type' => 'page', 'title' => 'Contact']);
    $contact = $matches ? reset($matches) : NULL;
  }
  if (!$contact) {
    return t('The /contact source node was not found; no content was changed.');
  }

  $contact->set('body', [
    'value' => <<<'HTML'
<p>Tell us what you need your website or automation to accomplish. We will reply by email with clear next steps and a scoped price.</p>
<h3>Reach the Team</h3>
<ul>
  <li><strong>Email:</strong> <a href="mailto:hello@famtasticdesigns.com">hello@famtasticdesigns.com</a></li>
  <li><strong>Response:</strong> Within one business day.</li>
</ul>
<p>No sales call is required. Use the form or email us whenever it works for you.</p>
HTML,
    'format' => 'full_html',
  ]);
  $fields = [
    'field_hero_subheadline' => 'Share what you need and receive a clear, fixed-price next step without a required sales call.',
    'field_cta_text' => 'Send Message',
    'field_cta_link' => ['uri' => 'internal:/contact#contact-form', 'title' => 'Send Message'],
    'field_meta_description' => 'Contact FAMtastic Designs by secure form or email at hello@famtasticdesigns.com. Get a clear scope and fixed-price next step without a required sales call.',
  ];
  foreach ($fields as $field => $value) {
    if ($contact->hasField($field)) {
      $contact->set($field, $value);
    }
  }
  $contact->save();
  return t('Updated /contact to email-first, non-storefront contact language.');
}


/** Creates the famtastic_customer role so registered users can be tagged. */
function famtastic_pipeline_update_8040(&$sandbox) {
  $roleStorage = \Drupal::entityTypeManager()->getStorage('user_role');
  $role = $roleStorage->load('famtastic_customer');

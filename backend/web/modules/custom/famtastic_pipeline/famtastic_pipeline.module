<?php

/**
 * @file
 * FAMtastic Pipeline module hooks.
 */

declare(strict_types=1);

use Drupal\Core\Entity\EntityInterface;
use Drupal\user\UserInterface;

/**
 * Implements hook_page_attachments().
 *
 * Gives Drupal Commerce checkout a branded, responsive presentation while the
 * rest of the public site remains React-owned.
 */
function famtastic_pipeline_page_attachments(array &$attachments): void {
  $routeName = (string) \Drupal::routeMatch()->getRouteName();
  if (str_starts_with($routeName, 'commerce_checkout.')) {
    $attachments['#attached']['library'][] = 'famtastic_pipeline/commerce_checkout';
  }
  // Suppress the React frontend header on user account pages and error pages —
  // the admin toolbar already provides navigation; mixing both creates visual chaos.
  $suppressRoutes = ['user.', 'profile.', 'system.403', 'system.404'];
  foreach ($suppressRoutes as $prefix) {
    if (str_starts_with($routeName, $prefix)) {
      $attachments['#attached']['library'][] = 'famtastic_pipeline/user_page_clean';
      break;
    }
  }

}

/**
 * Implements hook_user_insert().
 *
 * Every registered user becomes a FAMtastic customer. If a prospect already
 * exists with the same email, the customer is linked to it so proofs,
 * projects, and intake data carry forward.
 */
function famtastic_pipeline_user_insert(UserInterface $account): void {
  try {
    $portal = \Drupal::service('famtastic_pipeline.customer_portal');
    // A validated public-preview continuation is established by the branded
    // registration controller before User::save(). Keep this hook from
    // mistaking its inherited prospect discovery notes for a submitted
    // customer request before that customer proves control of the email.
    $isPublicPreviewRegistration = $portal->hasPendingPublicPreviewRegistration((string) $account->getEmail());
    $customer = $portal->customerForUid((int) $account->id());
    if (!$customer) {
      $customer = $portal->createCustomer($account, [
        'name' => $account->getDisplayName() ?: $account->getEmail(),
        'source' => 'registration',
      ]);
    }
    // Ensure a customer role exists and is assigned for portal access.
    $roleStorage = \Drupal::entityTypeManager()->getStorage('user_role');
    $customerRole = $roleStorage->load('famtastic_customer');
    if ($customerRole && !$account->hasRole('famtastic_customer')) {
      $account->addRole('famtastic_customer')->save();
    }
    // Preserve the historical convenience for ordinary registrations only.
    // Public-preview claims happen after email verification and the customer
    // then explicitly creates their detailed portal request.
    if (!$isPublicPreviewRegistration && !empty($customer['prospect_id']) && !empty($customer['id'])) {
      $organizations = $portal->organizations((int) $customer['id']);
      if ($organizations) {
        $portal->createWebsiteRequestFromProspectDiscovery(
          (int) $customer['id'],
          (int) $customer['prospect_id'],
          (int) $organizations[0]['id']
        );
      }
    }
  }
  catch (\Throwable $error) {
    \Drupal::logger('famtastic_pipeline')->error(
      'Customer auto-create failed for registered user @uid: @error',
      ['@uid' => $account->id(), '@error' => $error->getMessage()]
    );
  }
}

/**
 * Implements hook_entity_insert().
 */
function famtastic_pipeline_entity_insert(EntityInterface $entity): void {
  _famtastic_pipeline_maybe_fulfill_commerce_order($entity);
  _famtastic_pipeline_maybe_reconcile_commerce_payment($entity);
}

/**
 * Implements hook_entity_update().
 */
function famtastic_pipeline_entity_update(EntityInterface $entity): void {
  _famtastic_pipeline_maybe_fulfill_commerce_order($entity);
  _famtastic_pipeline_maybe_reconcile_commerce_payment($entity);
}

/** Reconciles Commerce payment state into the lifecycle and notification outbox. */
function _famtastic_pipeline_maybe_reconcile_commerce_payment(EntityInterface $entity): void {
  if ($entity->getEntityTypeId() !== 'commerce_payment') return;
  try {
    \Drupal::service('famtastic_pipeline.commerce_lifecycle')->reconcilePayment($entity);
  }
  catch (\Throwable $error) {
    \Drupal::logger('famtastic_pipeline')->error('Commerce payment reconciliation failed for payment @id: @error', ['@id' => $entity->id(), '@error' => $error->getMessage()]);
  }
}

/**
 * Bridges only completed Commerce orders into the customer lifecycle.
 */
function _famtastic_pipeline_maybe_fulfill_commerce_order(EntityInterface $entity): void {
  if ($entity->getEntityTypeId() !== 'commerce_order' || $entity->getState()->value !== 'completed') {
    return;
  }
  try {
    \Drupal::service('famtastic_pipeline.commerce_lifecycle')->fulfill($entity);
  }
  catch (\Throwable $error) {
    \Drupal::logger('famtastic_pipeline')->error('Commerce lifecycle fulfillment failed for order @id: @error', [
      '@id' => $entity->id(), '@error' => $error->getMessage(),
    ]);
  }
}

/**
 * Implements hook_help().
 */
function famtastic_pipeline_help(string $route_name): ?string {
  if ($route_name === 'help.page.famtastic_pipeline') {
    return '<p>' . t('Prospect → confirm → pay ($199 test) → intake → Site Studio request → project/approval pipeline. See docs/FAMTASTIC_PROSPECT_PIPELINE_V1.md.') . '</p>';
  }
  return NULL;
}

/**
 * Implements hook_mail().
 */
function famtastic_pipeline_mail(string $key, array &$message, array $params): void {
  if ($key !== 'outreach') {
    return;
  }

  $message['subject'] = (string) ($params['subject'] ?? 'FAMtastic Designs notification');
  $message['body'][] = (string) ($params['body'] ?? '');

  if (!empty($params['from'])) {
    $message['headers']['From'] = (string) $params['from'];
  }
}

/**
 * Implements hook_cron().
 *
 * Sends one durable alert when a public lead misses its first-response SLA.
 */
function famtastic_pipeline_cron(): void {
  try {
    $operations = \Drupal::service('famtastic_pipeline.lifecycle_operations');
    $operations->runProtection();
    $operations->runAutomation(10);
    $operations->dispatchNotifications(50);
  }
  catch (\Throwable $error) {
    \Drupal::logger('famtastic_pipeline')->error('Lifecycle worker failed: @error', ['@error' => $error->getMessage()]);
  }
  $config = \Drupal::config('famtastic_pipeline.settings');
  if (!$config->get('sla_alerts_enabled')) {
    return;
  }
  $recipient = (string) ($config->get('notification_to_email') ?: 'fitzgerald.medine@gmail.com');
  $now = \Drupal::time()->getRequestTime();
  $storage = \Drupal::entityTypeManager()->getStorage('famtastic_prospect');
  $ids = $storage->getQuery()->accessCheck(FALSE)
    ->condition('status', 'lead')
    ->condition('first_response_due', 0, '>')
    ->condition('first_response_due', $now, '<=')
    ->notExists('first_responded_at')
    ->notExists('sla_alerted_at')
    ->sort('first_response_due', 'ASC')
    ->range(0, 25)
    ->execute();
  foreach ($storage->loadMultiple($ids) as $prospect) {
    try {
      \Drupal::service('famtastic_pipeline.mailer')->send(
        $recipient,
        'Overdue lead response — ' . $prospect->label(),
        "A FAMtastic lead has passed its three-day response deadline.\n\n"
          . 'Lead: ' . $prospect->label() . "\n"
          . 'Email: ' . $prospect->get('public_email')->value . "\n"
          . 'Deadline: ' . gmdate(DATE_ATOM, (int) $prospect->get('first_response_due')->value) . "\n\n"
          . 'Open lead: https://famtasticdesigns.com/web/admin/famtastic/prospect/' . $prospect->id() . '/edit',
      );
      $prospect->set('sla_alerted_at', $now)->save();
    }
    catch (\Throwable $error) {
      \Drupal::logger('famtastic_pipeline')->error('SLA alert failed for prospect @id: @error', [
        '@id' => $prospect->id(),
        '@error' => $error->getMessage(),
      ]);
    }
  }
}

/**
 * Implements hook_commerce_order_insert().
 *
 * Branded order numbers: FAM-YYMM-NNNN. A bare "order number 2" reads as
 * day-one startup; the padded date-prefixed number reads as an established
 * operation. Applies to every new order at creation.
 */
function famtastic_pipeline_commerce_order_insert(\Drupal\Core\Entity\EntityInterface $entity) {
  if ($entity->getEntityTypeId() !== 'commerce_order') {
    return;
  }
  if (!empty((string) $entity->get('order_number')->value) || (string) $entity->get('order_number')->value === '0') {
    return;
  }
  static $composing = FALSE;
  if ($composing) {
    return;
  }
  $composing = TRUE;
  $entity->set('order_number', sprintf('FAM-%s-%04d', date('ym'), (int) $entity->id()));
  $entity->save();
  $composing = FALSE;
}

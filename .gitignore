.artifacts/
# Local proof runs, screenshots, signed packets, and browser evidence are
# retained outside Git. Curated manifests may be copied into docs/qa when a
# release needs durable repository evidence.
artifacts/

# Python runtime caches are reproducible and never source artifacts.
__pycache__/
*.py[cod]
marketing/video/node_modules/
marketing/video/out/
marketing/runtime/

# Pilot proofs are reproducible/generated evidence, not application source.
# Keep their normalized intakes, prompts, direction contracts, builders, and
# verifiers under version control; retain rendered sites, images, screenshots,
# videos, and zip files outside Git.
*.mp4
*.zip

# EXEMPTION — the public film library at /watch. These MP4s are not
# reproducible evidence, they are the deployed artifact: the page serves them
# straight from the document root, and the deploy script builds a committed SHA
# in a clean worktree. An untracked film would build fine locally and 404 in
# production with no error anywhere. Keep this rule below `*.mp4`, and note that
# Git cannot re-include a file whose parent directory is excluded — so this only
# works because frontend/public/ is itself tracked.
!frontend/public/video/*.mp4

# nested app checkouts, and dependency output in the artifact/Drive evidence
# lanes described by the Build DNA record.
website-delivery-swarm/pilots/**/assets/
website-delivery-swarm/pilots/**/visual-directions/
website-delivery-swarm/pilots/**/site/
website-delivery-swarm/pilots/**/safe-site/
website-delivery-swarm/pilots/**/wild-site/
website-delivery-swarm/pilots/**/proof/
website-delivery-swarm/pilots/**/proof-hub/
# Locally symlinked shared skills (absolute paths — machine-specific)
.claude/skills/

# Packaged asset bundle — repackages content already tracked in this repo
marketing/*.zip

# Remotion build workspace for marketing/video: staged copies of assets whose
# canonical homes are marketing/campaigns/**/images/ (plates), HeyGen (presenter
# video + voice-over) and frontend/public/brand/ (mark). Regenerate with
# `npm --prefix marketing/video run prepare:drop06`.
marketing/video/public/

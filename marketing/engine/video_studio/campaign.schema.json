{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Local video campaign",
  "type": "object",
  "required": [
    "schema",
    "id",
    "title",
    "scenes"
  ],
  "properties": {
    "schema": {
      "const": "video-studio.campaign.v1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,79}$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "mode": {
      "enum": [
        "motion_graphics",
        "editorial",
        "ai_footage"
      ]
    },
    "format": {
      "enum": [
        "9:16",
        "4:5",
        "1:1",
        "16:9"
      ]
    },
    "fps": {
      "enum": [
        24,
        25,
        30,
        60
      ]
    },
    "audio": {
      "type": "string"
    },
    "script": {
      "type": "string",
      "maxLength": 20000
    },
    "captions": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "required": [
          "start",
          "end",
          "text"
        ],
        "properties": {
          "start": {
            "type": "number",
            "minimum": 0
          },
          "end": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 180
          }
        }
      }
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 60,
      "items": {
        "type": "object",
        "required": [
          "id",
          "duration",
          "layout",
          "headline"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,79}$"
          },
          "duration": {
            "type": "number",
            "minimum": 0.5,
            "maximum": 60
          },
          "layout": {
            "enum": [
              "signal",
              "split",
              "monument",
              "resolve"
            ]
          },
          "headline": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "body": {
            "type": "string",
            "maxLength": 240
          },
          "media": {
            "type": "string"
          },
          "media_kind": {
            "enum": [
              "image",
              "video"
            ]
          },
          "rights": {
            "enum": [
              "owned",
              "licensed",
              "generated",
              "public_domain"
            ]
          },
          "source_audio": {
            "const": "discard"
          },
          "trim_start": {
            "type": "number",
            "minimum": 0
          }
        }
      }
    }
  },
  "description": "The Python runtime additionally checks local files, source duration/audio policy, timing, exact logo and caption bounds. JSON Schema alone is not production validation."
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://famtastic-marketing-engine.local/schemas/campaign-manifest-v1.json",
  "title": "Marketing campaign manifest",
  "type": "object",
  "required": [
    "schema_version",
    "campaign",
    "public_publish_enabled",
    "record_count",
    "records"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "campaign": { "type": "string", "minLength": 1 },
    "public_publish_enabled": { "type": "boolean" },
    "record_count": { "type": "integer", "minimum": 1 },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "content_id",
          "campaign",
          "state",
          "channels",
          "asset_variants",
          "utm",
          "approval",
          "provider_ids",
          "evidence"
        ],
        "properties": {
          "content_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]+$" },
          "campaign": { "type": "string", "minLength": 1 },
          "state": {
            "enum": [
              "idea", "briefed", "drafted", "content_qa", "seo_qa",
              "media_ready", "approved", "scheduled", "published",
              "verified", "measured", "learned", "revision_required",
              "delivery_failed", "blocked"
            ]
          },
          "channels": { "type": "array", "items": { "type": "string" } },
          "asset_variants": { "type": "array", "items": { "type": "string" } },
          "utm": {
            "type": "object",
            "required": ["source", "medium", "campaign", "content"],
            "additionalProperties": { "type": "string" }
          },
          "approval": {
            "type": "object",
            "required": ["content", "media", "publish"],
            "properties": {
              "content": { "type": "boolean" },
              "media": { "type": "boolean" },
              "publish": { "type": "boolean" }
            },
            "additionalProperties": false
          },
          "provider_ids": { "type": "object" },
          "evidence": { "type": "array" }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}

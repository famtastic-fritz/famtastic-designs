{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://famtasticdesigns.com/schemas/creative-job.v1.json",
  "title": "FAMtastic creative job",
  "type": "object",
  "required": ["schema_version", "job_id", "status", "human_brief", "input_sources", "requested_output", "experiment", "authority"],
  "properties": {
    "schema_version": { "const": "famtastic.creative-job.v1" },
    "job_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]+$" },
    "status": { "enum": ["draft", "planned", "running", "review", "promoted", "rejected", "blocked"] },
    "human_brief": { "type": "string", "minLength": 1 },
    "input_sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "kind", "location_or_hash"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]+$" },
          "kind": { "enum": ["brief", "blog", "brand_guide", "research", "design_guide", "image", "audio", "video", "asset_node", "other"] },
          "location_or_hash": { "type": "string", "minLength": 1 },
          "rights_or_authority": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "requested_output": {
      "type": "object",
      "required": ["family", "purpose"],
      "properties": {
        "family": { "enum": ["copy", "still", "video", "composition", "other"] },
        "purpose": { "type": "string", "minLength": 1 },
        "destination": { "type": "string" }
      },
      "additionalProperties": false
    },
    "experiment": {
      "type": "object",
      "required": ["mode", "budget_usd", "candidates", "qa_dimensions"],
      "properties": {
        "mode": { "const": "evidence_first" },
        "budget_usd": { "type": "number", "exclusiveMinimum": 0 },
        "candidates": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "object",
            "required": ["id", "class", "capability"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]+$" },
              "class": { "enum": ["premium", "cheap", "local"] },
              "capability": { "type": "string", "minLength": 1 },
              "provider_hint": { "type": "string" },
              "model_hint": { "type": "string" }
            },
            "additionalProperties": false
          }
        },
        "qa_dimensions": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      },
      "additionalProperties": false
    },
    "authority": {
      "type": "object",
      "required": ["spend_authorized", "upload_authorized", "publish_authorized"],
      "properties": {
        "spend_authorized": { "type": "boolean" },
        "upload_authorized": { "type": "boolean" },
        "publish_authorized": { "const": false }
      },
      "additionalProperties": false
    },
    "visual_treatment": {
      "type": "object",
      "required": ["origin", "status"],
      "properties": {
        "origin": { "enum": ["human_brief", "approved_experiment"] },
        "status": { "enum": ["not_requested", "draft", "reviewed"] },
        "asset_node_id": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}

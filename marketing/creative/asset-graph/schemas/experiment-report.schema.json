{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://famtasticdesigns.com/schemas/creative-experiment-report.v1.json",
  "title": "FAMtastic creative experiment report",
  "type": "object",
  "required": ["schema_version", "job_id", "premium_baseline_node_id", "cheap_candidate_node_ids", "qa_results", "human_decision"],
  "properties": {
    "schema_version": { "const": "famtastic.creative-experiment-report.v1" },
    "job_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]+$" },
    "premium_baseline_node_id": { "type": "string", "minLength": 1 },
    "cheap_candidate_node_ids": { "type": "array", "minItems": 2, "items": { "type": "string", "minLength": 1 } },
    "qa_results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["node_id", "dimensions", "decision"],
        "properties": {
          "node_id": { "type": "string", "minLength": 1 },
          "dimensions": { "type": "object", "minProperties": 1, "additionalProperties": { "type": "string" } },
          "decision": { "enum": ["accepted", "rejected", "revise"] }
        },
        "additionalProperties": false
      }
    },
    "human_decision": { "enum": ["promote_route", "keep_experimental", "reject_route"] }
  },
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://famtasticdesigns.com/schemas/campaign-story.schema.json",
  "title": "FAMtastic campaign story",
  "type": "object",
  "required": ["schema_version", "status", "source", "creative_brief", "claim_ledger", "scenes", "asset_policy", "render_gate"],
  "properties": {
    "schema_version": { "const": "campaign-story.v1" },
    "status": { "enum": ["seed", "briefed", "storyboard_ready", "approved_for_render", "rendered", "rejected"] },
    "source": {
      "type": "object",
      "required": ["title", "url_or_path", "source_kind"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "url_or_path": { "type": "string", "minLength": 1 },
        "source_kind": { "enum": ["blog", "campaign_brief", "research", "offer", "other"] }
      },
      "additionalProperties": false
    },
    "creative_brief": {
      "type": "object",
      "required": ["angle", "audience", "destination", "duration_seconds", "visual_metaphor"],
      "properties": {
        "angle": { "enum": ["concept", "how_to", "listicle", "narrative", "case_study"] },
        "audience": { "type": "string", "minLength": 1 },
        "destination": { "enum": ["9:16", "1:1", "16:9", "custom"] },
        "duration_seconds": { "type": "integer", "minimum": 30, "maximum": 90 },
        "visual_metaphor": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "claim_ledger": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "claim", "source", "on_screen_or_spoken"],
        "properties": {
          "id": { "type": "string", "pattern": "^CL-[0-9]+$" },
          "claim": { "type": "string", "minLength": 1 },
          "source": { "type": "string", "minLength": 1 },
          "on_screen_or_spoken": { "enum": ["on_screen", "spoken", "both", "neither"] }
        },
        "additionalProperties": false
      }
    },
    "scenes": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "required": ["id", "range_seconds", "story_beat", "visual_purpose", "visual", "copy_or_narration", "asset_needed", "continuity_locks"],
        "properties": {
          "id": { "type": "string", "pattern": "^S[0-9]+$" },
          "range_seconds": { "type": "string", "pattern": "^[0-9]+-[0-9]+$" },
          "story_beat": { "enum": ["hook", "friction", "mechanism", "turn", "proof", "offer", "cta", "resolution"] },
          "visual_purpose": { "type": "string", "minLength": 1 },
          "visual": { "type": "string", "minLength": 1 },
          "copy_or_narration": { "type": "string" },
          "asset_needed": { "type": "string", "minLength": 1 },
          "continuity_locks": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": false
      }
    },
    "asset_policy": {
      "type": "object",
      "required": ["anchor_strategy", "text_policy", "receipt_required"],
      "properties": {
        "anchor_strategy": { "enum": ["none", "approved_reference_edit", "approval_gated_premium_anchor", "validated_local_control"] },
        "text_policy": { "const": "compose_later_no_generated_type" },
        "receipt_required": { "const": true }
      },
      "additionalProperties": false
    },
    "render_gate": {
      "type": "object",
      "required": ["storyboard_reviewed", "claim_ledger_reviewed", "provider_authorized", "status"],
      "properties": {
        "storyboard_reviewed": { "type": "boolean" },
        "claim_ledger_reviewed": { "type": "boolean" },
        "provider_authorized": { "type": "boolean" },
        "status": { "enum": ["not_ready", "ready", "rendered"] }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}

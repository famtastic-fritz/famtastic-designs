{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://famtasticdesigns.com/schemas/proof-runner-request.v1.schema.json",
  "title": "FAMtastic source-bound proof runner request",
  "type": "object",
  "required": ["schema", "contract_version", "build_id", "idempotency_key", "routine", "created_at", "source", "profile", "build_class", "provider_preflight", "mutation_policy", "return_contract"],
  "properties": {
    "schema": {"const": "famtastic.proof-runner-request.v1"},
    "contract_version": {"type": "string", "minLength": 1},
    "build_id": {"type": "string", "minLength": 8},
    "idempotency_key": {"type": "string", "minLength": 8},
    "routine": {"const": "website_proof.generate.v1"},
    "created_at": {"type": "string", "format": "date-time"},
    "source": {
      "type": "object",
      "required": ["type", "prospect_id", "contact_hash"],
      "properties": {
        "type": {"enum": ["public_solution_finder_intake", "authenticated_website_request"]},
        "prospect_id": {"type": "integer", "minimum": 1},
        "contact_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      },
      "additionalProperties": true
    },
    "profile": {
      "type": "object",
      "required": ["id", "proof_count", "directions", "customer_visibility"],
      "properties": {
        "id": {"enum": ["public_initial.v1", "portal_initial.v1", "portal_showcase.v1", "portal_refined_six.v1"]},
        "proof_count": {"enum": [3, 6]},
        "directions": {"type": "object"},
        "customer_visibility": {"const": "owner_review_only"}
      },
      "additionalProperties": true
    },
    "build_class": {"enum": ["free", "low", "medium", "premium", "premium_brain_free_workers", "custom"]},
    "provider_preflight": {"type": "object", "required": ["status", "ready", "transport", "classification", "reason", "provider"]},
    "mutation_policy": {"type": "object"},
    "return_contract": {"type": "object"}
  },
  "allOf": [
    {
      "if": {"properties": {"profile": {"properties": {"id": {"const": "portal_refined_six.v1"}}}}},
      "then": {
        "properties": {
          "source": {
            "required": [
              "proof_phase",
              "source_preview_delivery_id",
              "public_preview_delivery_id",
              "website_request_id",
              "website_request_public_id",
              "parent_public_proof_campaign_id",
              "parent_public_campaign_key",
              "parent_public_build_dna_id",
              "parent_public_build_dna_hash",
              "lineage",
              "lineage_hash"
            ],
            "properties": {
              "proof_phase": {"const": "refined_six"},
              "source_preview_delivery_id": {"type": "integer", "minimum": 1},
              "public_preview_delivery_id": {"type": "integer", "minimum": 1},
              "website_request_id": {"type": "integer", "minimum": 1},
              "website_request_public_id": {"type": "string", "minLength": 1},
              "parent_public_proof_campaign_id": {"type": "integer", "minimum": 1},
              "parent_public_campaign_key": {"type": "string", "minLength": 1},
              "parent_public_build_dna_id": {"type": "string", "minLength": 1},
              "parent_public_build_dna_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
              "lineage_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
            }
          }
        }
      }
    }
  ],
  "additionalProperties": true
}
